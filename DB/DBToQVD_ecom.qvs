//Документ.ЗаказПокупателя.ТабличнаяЧасть.Товары для ЯндексДоставки
if InRollBack or isnull(FileSize('$(vQVDPath)/_Document/_Document221_VT1951/_Document221_VT1951_$(FileSuffix).qvd')) then

TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);	

_Document221_VT1951:
load *;
;
SQL SELECT 
	*
FROM "UT-PLAYH".dbo."_Document221_VT1951"
inner join
"UT-PLAYH".dbo."_Document221"
on 
_Document221_VT1951._Document221_IDRRef=_Document221._IDRRef
where Convert(date,_Date_Time,104)>= Convert(date,'$(DateFrom)',104) and Convert(date,_Date_Time,104)< Convert(date,'$(DateToSQL)',104)
and _Posted=01 and _Marked=00
;

store _Document221_VT1951 into [$(vQVDPath)/_Document/_Document221_VT1951/_Document221_VT1951_$(FileSuffix).qvd](qvd);
drop table _Document221_VT1951;

