//$tab РегистрыНакоплений


let DateInc = DateStart;
let DateLoadTo = DateFinish; 

do
	let DateFrom = DateInc; 
	let DateTo = MonthEnd(DateInc);
	let DateToSQL = date(MonthEnd(DateInc)+1);
	let FileSuffix = Text(date(AddYears(DateInc,-2000),'YYYY_MM'));
	let InRollBack  = (DateInc>=AddMonths(DateLoadTo, -RollBackMonthCount));	

if InRollBack or isnull(FileSize('$(vQVDPath)/_AccumRg/_AccumRg11284/_AccumRg11284_$(FileSuffix).qvd')) then
	
TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);	

//РегистрНакопления.ПродажиСебестоимость для ЯндексДоставки
_AccumRg11284:
load *;
;
SQL SELECT 
	Convert(date,_Period,104) as Дата,
    [_RecorderTRef] as "Тип документа",
    _RecorderRRef,
    _Fld11285RRef as КодНоменклатура,
    _Fld11287_RRRef as _Document221_IDRRef, //ЗаказПокупателя
    Sum(_Fld11292) as Количество,
    Sum(_Fld11293)/Sum(_Fld11292) as Стоимость
FROM "UT-PLAYH".dbo."_AccumRg11284"
where Convert(date,_Period,104)>= Convert(date,'$(DateFrom)',104) and Convert(date,_Period,104)< Convert(date,'$(DateToSQL)',104)
Group by Convert(date,_Period,104), _RecorderRRef, _Fld11285RRef, _Fld11287_RRRef, _RecorderTRef
;

store _AccumRg11284 into [$(vQVDPath)/_AccumRg/_AccumRg11284/_AccumRg11284_$(FileSuffix).qvd](qvd);
drop table _AccumRg11284;

ENDIF

let DateInc = timestamp(AddMonths(DateInc, 1));
LOOP while not InMonth(DateInc, DateLoadTo, 1); //exit script;


//$tab РегистрыCведений


// РегистрСведений.ВерсииОбъектов для для ЯндексДоставки или LoyaMobile с временем промежуточных Статусов
_InfoRg8826_Status:
LOAD *;
SQL 
SELECT [_Fld8827_RRRef] as _Document221_IDRRef,
	MIN(CASE WHEN [_Fld8832] = N'Ожидает подтверждения' THEN DATEADD(YEAR, -2000, [_Fld8831]) END) AS ДатаПоступления,
    MIN(CASE WHEN [_Fld8832] = N'Подтвержден' THEN DATEADD(YEAR, -2000, [_Fld8831]) END) AS ДатаПодтверждения,
    MIN(CASE WHEN [_Fld8832] = N'Собран' THEN DATEADD(YEAR, -2000, [_Fld8831]) END) AS ДатаСборки
from [UT-PLAYH].dbo.[_InfoRg8826] where [_Fld8827_RRRef] in 
	(SELECT [_IDRRef] FROM [UT-PLAYH].dbo.[_Document221]
	WHERE ([_Fld1918RRef] = 0xB9E400155DF9F40611EFB3A0A092FDE6 OR [_Fld1918RRef] = 0x977E3CECEF19CCC511F00EE440C8DF7B OR ([_Fld1918RRef] = 0xB9A000155D1D6B2011ECA3943DE225A7 AND [_Fld21654] = 1))
    and [_Posted] = 01 and [_Marked] = 00 
    and DATEADD(YEAR, -2000, Convert(date,[_Date_Time],23)) > '30-09-2025 23:59:59')
group by [_Fld8827_RRRef];
    				// B9E400155DF9F40611EFB3A0A092FDE6 Яндекс Деливери Бай ООО
																				// 977E3CECEF19CCC511F00EE440C8DF7B Loya mobile //B9A000155D1D6B2011ECA3943DE225A7 AND _Fld21654 = 1 Website
store _InfoRg8826_Status into [$(vQVDPath)/_InfoRg/_InfoRg8826_Status.qvd](qvd);
drop table _InfoRg8826_Status;

//exit script;

// РегистрСведений.ВерсииОбъектов для ЯндексДоставки или LoyaMobile статус "Аннулирован" или для LoyaMobile статус "Просрочен"
_InfoRg8826:
LOAD *;
SQL
Select t1._Document221_IDRRef, t1.Дата, t1.Автор, d.[_Fld1929RRef] as КодСтатусЗаказ 
from ( 
SELECT ir.[_Fld8827_RRRef] as _Document221_IDRRef, ir.[_Fld8830_RRRef] as Автор,  DATEADD(YEAR, -2000,Convert(date,ir.[_Fld8831],104)) as Дата, 
Row_Number() over (partition by ir.[_Fld8827_RRRef] order by ir.[_Fld8828] desc ) as NN
from [UT-PLAYH].dbo.[_InfoRg8826] ir 
where ir.[_Fld8827_RRRef] in (SELECT [_IDRRef] FROM [UT-PLAYH].dbo.[_Document221]
WHERE ([_Fld1929RRef] = 0xB3317DF3BA84E9E9455BB4C811186CD9 or [_Fld1929RRef] = 0x92DEF361C7C96BF543AA190705C0595D or [_Fld1929RRef] = 0xA8E66861BEFCE5BA48C9043F3813A1B8) 
		and [_Date_Time] >= '4024-11-07' and [_Posted] = 1 and [_Marked] = 0)
) as t1 
left join [UT-PLAYH].dbo.[_Document221] as d on t1._Document221_IDRRef = d.[_IDRRef]
where NN=1;

store _InfoRg8826 into [$(vQVDPath)/_InfoRg/_InfoRg8826.qvd](qvd);
drop table _InfoRg8826;

//exit script;




