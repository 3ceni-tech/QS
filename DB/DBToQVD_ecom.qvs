let DateStart = date(AddYears(MakeDate((2024),1,1),2000));
let DateFinish = date(AddYears(today(1)-1,2000));
let RollBackMonthCount = IF(FullReload=1,23,3);
//let RollBackMonthCount = IF(FullReload=1,35,IF(match(num(WeekDay(today(2))),5,6),35,3)); 
 
