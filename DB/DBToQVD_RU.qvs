	*
FROM "UT-WBFM".dbo."_AccumRg19831"
where Convert(date,_Period,104)>= Convert(date,'$(DateFrom)',104) and Convert(date,_Period,104)< Convert(date,'$(DateToSQL)',104)
;

store _AccumRg19831 into [$(vQVDPath)/_AccumRg/_AccumRg19831/_AccumRg19831_$(FileSuffix).qvd](qvd);
