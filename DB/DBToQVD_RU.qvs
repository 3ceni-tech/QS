//РегистрСведений.Ассортимент
_InfoRg15012:
Load
	*
;
SQL 
SELECT  
  Convert(date,DATEADD(YEAR, -2000, _Period),23) as Дата, 
  [_RecorderRRef], 
  [_LineNo], 
  [_Active], 
  [_Fld15013RRef] КодСтрЕд, 
  [_Fld15014RRef] КодНоменклатура, 
  [_Fld15015RRef] КодСтатусТовара,
  [_Fld15016] AS ДатаОбнАссорт
FROM [UT-WBFM].dbo.[_InfoRg15012]
where [_Active]=1 //and [_Fld15015RRef]<>0x831F00155D00024711EF3529D0B02BFE
;

store _InfoRg15012 into [$(vQVDPath)/_InfoRg/_InfoRg15012.qvd](qvd);
drop table _InfoRg15012;

