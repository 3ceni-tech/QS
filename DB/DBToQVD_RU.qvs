if InRollBack or isnull(FileSize('$(vQVDPath)/_AccumRg/_AccumRg20403/_AccumRg20403_$(FileSuffix).qvd')) then
	
TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);	

_AccumRg20403:
load *;
;
SQL SELECT 
	*
FROM "UT-WBFM".dbo."_AccumRg20403"
where Convert(date,_Period,104)>= Convert(date,'$(DateFrom)',104) and Convert(date,_Period,104)< Convert(date,'$(DateToSQL)',104)
;

store _AccumRg20403 into [$(vQVDPath)/_AccumRg/_AccumRg20403/_AccumRg20403_$(FileSuffix).qvd](qvd);
drop table _AccumRg20403;
ENDIF

