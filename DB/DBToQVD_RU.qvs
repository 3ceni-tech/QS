Документ.Списание (_Document708X1) - Документ.Списание.ТабличнаяЧасть.Состав (_Document708_VT7394X1)
*/


let DateInc = DateStart;
let DateLoadTo = DateFinish; 

do
	let DateFrom = DateInc; 
	let DateTo = MonthEnd(DateInc);
	let DateToSQL = date(MonthEnd(DateInc)+1);
	let FileSuffix = Text(date(AddYears(DateInc,-2000),'YYYY_MM'));
	let InRollBack  = (DateInc>=AddMonths(DateLoadTo, -RollBackMonthCount));


if InRollBack or isnull(FileSize('$(vQVDPath)/_Document/_Document693_VT6254/_Document693_VT6254_$(FileSuffix).qvd')) then
	
TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);	

//Документ.РеализацияТоваровУслуг.Товары 
_Document693_VT6254:
load *;
SQL SELECT 
	*
FROM "UT-WBFM".dbo."_Document693_VT6254X1"
inner join
"UT-WBFM".dbo."_Document693X1"
on 
_Document693_VT6254X1._Document693_IDRRef=_Document693X1._IDRRef
where Convert(date,_Date_Time,104)>= Convert(date,'$(DateFrom)',104) and Convert(date,_Date_Time,104)< Convert(date,'$(DateToSQL)',104)
and _Posted=01 and _Marked=00
;

store _Document693_VT6254 into [$(vQVDPath)/_Document/_Document693_VT6254/_Document693_VT6254_$(FileSuffix).qvd](qvd);
drop table _Document693_VT6254;

ENDIF

