// Перечисление.nwpТипМагазина	
[_Enum633]:
LOAD *;	
SQL SELECT
    e._IDRRef as КодТипМагазин,
    e._EnumOrder,
    m.ТипМагазина
FROM "UT-PLAYH".dbo."_Enum633" e
    INNER JOIN (
       VALUES
            (0, 'Тип 1'),
            (1, 'Тип 2'),
            (2, 'Тип 3'),
            (3, 'Тип 4'),
            (4, 'Тип 5'),
            (5, 'Тип 6'),
            (6, 'Тип 7'),
            (7, 'Тип 8'),
            (8, 'Тип 9'),
            (9, 'Тип 10'),
            (10, 'Тип 11'),
            (11, 'Тип 12'),
            (12, 'Тип 1 N'),
            (13, 'Тип 2 N'),
            (14, 'Тип 3 N'),
            (15, 'Тип 4 N'),
            (16, 'Тип 5 N'),
            (17, 'Тип 6 N'),
            (18, 'Тип 7 N'),
            (19, 'Тип 8 N'),
            (20, 'Тип 9 N'),
            (21, 'Тип 10 N'),
            (22, 'Тип 11 N'),
            (23, 'Тип 12 N')
    ) m (_EnumOrder, ТипМагазина)
    ON e._EnumOrder = m._EnumOrder; 
store _Enum633 into [$(vQVDPath)/BUH-PLAYH/_Enum633.qvd](qvd);
drop table _Enum633;


