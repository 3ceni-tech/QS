/*
Документ.РеализацияТоваровУслуг.Товары (_Document299_VT5114)		
Документ.ОтчетОРозничныхПродажах.Товары (_Document270_VT3640)		
Документ.ВозвратТоваровОтПокупателя.Товары (_Document197_VT1211)    
*/

let DateInc = DateStart;
let DateLoadTo = DateFinish; 

do
	let DateFrom = DateInc; 
	let DateTo = MonthEnd(DateInc);
	let DateToSQL = date(MonthEnd(DateInc)+1);
	let FileSuffix = Text(date(AddYears(DateInc,-2000),'YYYY_MM'));
	let InRollBack  = (DateInc>=AddMonths(DateLoadTo, -RollBackMonthCount));


if InRollBack or isnull(FileSize('$(vQVDPath)/_Document/_Document299_VT5114/_Document299_VT5114_$(FileSuffix).qvd')) then
	
TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);	

//Документ.РеализацияТоваровУслуг.Товары 
_Document299_VT5114:
load *;
;
SQL SELECT 
	*
FROM "UT-PLAYH".dbo."_Document299_VT5114"
inner join
"UT-PLAYH".dbo."_Document299"
on 
_Document299_VT5114._Document299_IDRRef=_Document299._IDRRef
where Convert(date,_Date_Time,104)>= Convert(date,'$(DateFrom)',104) and Convert(date,_Date_Time,104)< Convert(date,'$(DateToSQL)',104)
and _Posted=01 and _Marked=00
;

store _Document299_VT5114 into [$(vQVDPath)/_Document/_Document299_VT5114/_Document299_VT5114_$(FileSuffix).qvd](qvd);
drop table _Document299_VT5114;

ENDIF

