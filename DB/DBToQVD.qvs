// РегистрСведений.ВерсииОбъектов для ЯндексДоставки
_InfoRg8826:
LOAD *;
SQL
Select _Document221_IDRRef, Автор from ( 
SELECT ir.[_Fld8827_RRRef] as _Document221_IDRRef, ir.[_Fld8830_RRRef] as Автор, Row_Number() over (partition by ir.[_Fld8827_RRRef] order by ir.[_Fld8828] desc ) as NN
from [UT-PLAYH].dbo.[_InfoRg8826] ir 
where ir.[_Fld8827_RRRef] in (SELECT [_IDRRef] FROM [UT-PLAYH].dbo.[_Document221]
WHERE [_Fld1929RRef] = 0xB3317DF3BA84E9E9455BB4C811186CD9 and [_Date_Time] >= '4024-11-07' and [_Posted] = 1)) as t1 where NN=1;

//     SQL SELECT * from [UT-PLAYH].dbo.[_InfoRg8826] ir where
// ir.[_Fld8827_RRRef] in (SELECT [_IDRRef] FROM [UT-PLAYH].dbo.[_Document221]
// WHERE [_Fld1929RRef] = 0xB3317DF3BA84E9E9455BB4C811186CD9 and [_Date_Time] >= '4024-11-07' and [_Posted] = 1);
store _InfoRg8826 into [$(vQVDPath)/_InfoRg/_InfoRg8826.qvd](qvd);
drop table _InfoRg8826;
//exit script;

