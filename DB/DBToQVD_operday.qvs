//$tab РеализацияТоваровУслуг_1С------------------------------------------------------------------------------------

//Документ.РеализацияТоваровУслуг 
РеализацияТоваровУслуг:
LOAD *;	
SQL SELECT 
	_IDRRef as Ссылка,
    _NumberPrefix as Дата,
    _Fld5057RRef as КодСклад,
    _Fld5047RRef as ТипПродажи,
    _Fld5065 as Сумма_бн,
	_Fld5112 as НДС_бн,
	_Fld20196 as СебесбНДС_бн 
FROM "UT-PLAYH".dbo."_Document299"
WHERE _Posted=1 and _Marked=0;

left join 
load *;
SQL SELECT
    (_Document299_IDRRef) as Ссылка,
    Sum(_Fld5119) as Количество_бн,
	Sum(_Fld5127) as Сумма1,
	Sum(_Fld5128) as СуммаНДС1,
	Sum(_Fld5138)as Себес1
FROM "UT-PLAYH".dbo."_Document299_VT5114"
	Group by _Document299_IDRRef;

Left Join
load *;
SQL SELECT
	(_IDRRef) as КодСклад,
	_Fld12835 as shopindex
FROM "UT-PLAYH".dbo."_Reference132";
// LOAD
// 	Text(_IDRRef) as КодСклад,
//     //_Description as  Склад,
//     //_Fld12772 as Город,
//     _Fld12835 as shopindex
// FROM [$(vDBQvdPath)/_Reference/_Reference132.qvd](qvd);
store РеализацияТоваровУслуг into  [$(vQVDPath)/SET/РеализацияТоваровУслуг_1С.qvd](qvd);
drop table РеализацияТоваровУслуг;
//exit script;


//$tab SET Таблицы--------------------------------------------------------------------------

/*
Чеки - od_purchase - кол-во и сумма чеков

*/

LIB CONNECT TO 'set_operday (fixmt_esipovich)';

let DateInc = DateStart;
let DateLoadTo = DateFinish; 

do
	let DateFrom = DateInc; 
	let DateTo = MonthEnd(DateInc);
	let DateToSQL = date(MonthEnd(DateInc)+1);
	let FileSuffix = Text(date(AddYears(DateInc,-0),'YYYY_MM'));
	let InRollBack  = (DateInc>=AddMonths(DateLoadTo, -RollBackMonthCount));	

if InRollBack or isnull(FileSize('$(QVDPath)/SET/od_purchase/od_purchase_$(FileSuffix).qvd')) then

TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);	

LOAD *;
[od_purchase]:
SQL SELECT
	id,
    id_shift,
	datecommit as Дата,
    operationtype,
    checksumend
FROM public.od_purchase
where datecommit>= '$(DateFrom)' and datecommit< '$(DateToSQL)' and checkstatus=0 ;

left join (od_purchase)
LOAD *;
//[od_position]:
SQL SELECT
	id_purchase as id,
    Count(id) as strok,
	SUM(ndssum) as NDS,
    SUM(qnty)/1000 as qty_item
FROM public.od_position
where datecommit>= '$(DateFrom)' and datecommit< '$(DateToSQL)' 
group by id_purchase;

left join (od_purchase)
LOAD *;
//[od_shift]:
SQL SELECT
	id as id_shift,
    shopindex
	FROM public.od_shift
	where operday>= '$(DateFrom)' and operday< '$(DateToSQL)'// and shopindex<>350
    group by id;
    
left join (od_purchase)
LOAD *;
//[od_payment]:
SQL SELECT
	id_purchase as id,
    paymentclass
	FROM public.od_payment
    where datecommit>= '$(DateFrom)' and datecommit< '$(DateToSQL)' and paymentclass=0;
	
store od_purchase into [$(QVDPath)/SET/od_purchase/od_purchase_$(FileSuffix).qvd](qvd);
drop table od_purchase;
ENDIF


