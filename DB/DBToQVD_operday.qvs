let DateInc = timestamp(AddMonths(DateInc, 1));
LOOP while not InMonth(DateInc, DateLoadTo, 1);

План:
LOAD 
    Date(Дата) as Дата,
    план_выручка,
    план_трафик,
    план_срчек,
    план_то,
    план_вп,
    'Ambition plan' as [Тип плана]
FROM [$(vExcelPath)/oper_plan.xlsx] (ooxml, embedded labels);

join(План)
LOAD 
    Date(Дата) as Дата,
    план_выручка,
    план_трафик,
    план_срчек,
    план_то,
    план_вп,
    'Base plan' as [Тип плана]
FROM [$(vExcelPath)/oper_plan_base.xlsx] (ooxml, embedded labels);

store План into [$(vQVDPath)/SET/oper_plan.qvd](qvd);
drop table План;
//exit script;


//$tab Счетчики посетителей-------------------------------------------------------

LIB CONNECT TO 'Countmax (fixmt_esipovich)';

let DateInc = DateStart;
let DateLoadTo = DateFinish; 

do
	let DateFrom = DateInc; 
	let DateTo = MonthEnd(DateInc);
	let DateToSQL = date(MonthEnd(DateInc)+1);
	let FileSuffix = Text(date(AddYears(DateInc,-0),'YYYY_MM'));
	let InRollBack  = (DateInc>=AddMonths(DateLoadTo, -RollBackMonthCount));	

if InRollBack or isnull(FileSize('$(QVDPath)/SET/od_purchase/od_purchase_$(FileSuffix).qvd')) then

	
TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);	

LOAD *;
[visitors]:
SELECT 	cmse.ID_Enter, 
		cme.NameEnter, 
        cast(RIGHT(cme.NameEnter, (len(cme.NameEnter)-PATINDEX('%[1-9]%',cme.NameEnter)+1)) as int) as shopindex, 
		//cmse.TimeRecord as Дата,
      	convert(date,cmse.TimeRecord,104) as Дата,
		DATEPART(hour, cmse.TimeRecord) as час,
		Sum(cmse.SumIn+cmse.SumOut)/2 as чел
        //cmse.SumIn as visitors_in,
		//cmse.SumOut as visitors_out
FROM Countmax.dbo.CM_StorageEnter as cmse
join Countmax.dbo.Cm_Enter as cme on cmse.ID_Enter = cme.ID_Enter
where Convert(date,cmse.TimeRecord,104)>= Convert(date,'$(DateFrom)',104) and Convert(date,cmse.TimeRecord,104)< Convert(date,'$(DateToSQL)',104)
and cmse.SumIn<>0 and cmse.SumOut<>0 and cme.ID_Project = '115449266'
group by cmse.ID_Enter, cme.NameEnter, convert(date,cmse.TimeRecord,104), DATEPART(hour, cmse.TimeRecord); 

store visitors into [$(QVDPath)/Countmax/visitors/visitors_$(FileSuffix).qvd](qvd);
drop table visitors;
ENDIF

let DateInc = timestamp(AddMonths(DateInc, 1));
LOOP while not InMonth(DateInc, DateLoadTo, 1);