//$tab Main------------------------------------------------------------------------------------

SET ThousandSep=' ';
SET DecimalSep=',';
SET MoneyThousandSep=' ';
SET MoneyDecimalSep=',';
SET MoneyFormat='# ##0,00 ₽;-# ##0,00 ₽';
SET TimeFormat='h:mm:ss';
SET DateFormat='DD.MM.YYYY';
SET TimestampFormat='DD.MM.YYYY h:mm:ss[.fff]';
SET FirstWeekDay=0;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='ru-RU';
SET CreateSearchIndexOnReload=0;
SET MonthNames='янв.;февр.;мар.;апр.;мая;июн.;июл.;авг.;сент.;окт.;нояб.;дек.';
SET LongMonthNames='январь;февраль;март;апрель;май;июнь;июль;август;сентябрь;октябрь;ноябрь;декабрь';
SET DayNames='пн;вт;ср;чт;пт;сб;вс';
SET LongDayNames='понедельник;вторник;среда;четверг;пятница;суббота;воскресенье';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';

//===================================================================
set vDBQvdPath=[lib://OLAP (fixmt_stefanovich)/];
set vQVDPath=[lib://ETL (fixmt_stefanovich)/];
set vExcelPath=[lib://Excel (fixmt_stefanovich)/];
//===============================1====================================
let FullReload=0; //Полная(1) или частичная(0) перегрузка
//===================================================================
//let DateStart=IF(FullReload=1,YearStart(AddYears(Today(1)-1,-2)),IF(match(num(WeekDay(today(2))),5,6),YearStart(AddYears(Today(1)-1,-2)),MonthStart(AddMonths(Today(1)-1,-3))));
let DateStart=IF(FullReload=1,YearStart(AddYears(Today(1)-1,-3)),MonthStart(AddMonths(Today(1)-1,-3)));
//Let DateStartStockDay = IF(FullReload=1,YearStart(AddYears(Today(1)-1,-1)),IF(match(num(WeekDay(today(2))),5,6),YearStart(AddYears(Today(1)-1,-1)),MonthStart(AddMonths(Today(1)-1,-3))));
Let DateStartStockDay = IF(FullReload=1,YearStart(AddYears(Today(1)-1,-2)), MonthStart(AddMonths(Today(1)-1,-3)));
//Let DateStartStockDay = IF(FullReload=1,YearStart(AddYears(Today(1)-1,-1)),IF(match(num(WeekDay(today(2))),5,6),YearStart(AddYears(Today(1)-1,-1)),MonthStart(AddMonths(Today(1)-1,-3))));
let DateStartAll=MonthStart(AddYears(Today(1)-1,-2)); //Для расчётов требующих фулл период
let DateEnd=MonthEnd(Today(1)-1);
let RollBackMonthCount =IF(FullReload=1,24,3);  
//Let RollBackMonthCount = IF(FullReload=1,42,IF(match(num(WeekDay(today(2))),5,6),42,3)); 

//===================================================================


//$tab Mappings------------------------------------------------------------------------------------

////=====================================================================
mapКонтрагент:
mapping load 
	КодКонтрагент,  
    Контрагент
FROM [$(vQVDPath)/Справочники/Контрагенты.qvd](qvd);

mapВидНоменклатуры:
mapping load
    КодВидНоменклатуры,
    ВидНоменклатуры
FROM [$(vQVDPath)/Справочники/ВидыНоменклатуры.qvd](qvd)
Where Match(ВидНоменклатуры,'Импортный','Товар РБ');

mapШтрихкод:
mapping load
    КодШтрихкод as КодНоменклатура,
    Штрихкод
FROM [$(vQVDPath)/РегистрыСведений/Штрихкоды.qvd](qvd);

mapПользователи:
mapping load 
	КодПользователь,  
    ИмяПользователя
FROM [$(vQVDPath)/Справочники/Пользователи.qvd](qvd);

mapСтавкаНДС:
mapping load 
    КодСтавкиНДС,
    СтавкаНДС
FROM [$(vQVDPath)/Перечисление/СтавкиНДС.qvd](qvd);

mapГруппаПоставщика:
mapping load 
    КодКонтрагент as КодОсновнойПоставщик,
    ApplyMap ('mapКонтрагент', КодРодитель) as ГруппаКонтрагента    
FROM [$(vQVDPath)/Справочники/Контрагенты.qvd](qvd);

mapNwpСтатусТовара:
mapping load 
    КодnwpСтатусТовара,
    nwpСтатусТовара as "Статусы товаров"    
FROM [$(vQVDPath)/Перечисление/nwpСтатусТовара.qvd](qvd);

mapNwpСтатусТовараАктив:
mapping load 
    КодnwpСтатусТовара,
    АктивныйАссортимент    
FROM [$(vQVDPath)/Перечисление/nwpСтатусТовара.qvd](qvd);

////=====================================================================
//если в регистре поле Склад пустое, то это сигнал, что нужно проваливаться в Документ.ПереоценкаТоваровВРознице (_Document274)
mapСкладПереоценка:
mapping load 
	Ссылка,
    КодСклад
FROM [$(vQVDPath)Документы/ПереоценкаТоваровВРознице.qvd](qvd);
////=====================================================================

mapКодСклад1C:
mapping load
	КодСклад1C,
    КодСклад
FROM [$(vQVDPath)/Справочники/Склады.qvd](qvd);

mapНаправление:
mapping load
	КодНаправление,
    Направление
FROM [$(vDBQvdPath)\_Reference\_Reference21344.qvd](qvd);

mapРегион:
mapping load
	КодРегион,
    Регион
FROM [$(vDBQvdPath)\_Reference\_Reference171.qvd](qvd);

//Костыли из-за планов
tmpНоменклатурнаяГруппа:
NoConcatenate load 
    КодНоменклатура,
    КодНоменклатурнаяГруппа  
FROM [$(vQVDPath)/Справочники/Номенклатура.qvd](qvd);

left join(tmpНоменклатурнаяГруппа)
LOAD
    КодНоменклатурнаяГруппа,
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2"
FROM [$(vQVDPath)/Справочники/НоменклатурныеГруппы.qvd]
(qvd);

mapНоменклатурнаяГруппа1:
mapping load 
	КодНоменклатура,
    "Номенклатурная группа – Уровень 1"
resident tmpНоменклатурнаяГруппа;

mapНоменклатурнаяГруппа2:
mapping load 
	КодНоменклатура,
    "Номенклатурная группа – Уровень 2"
resident tmpНоменклатурнаяГруппа;
drop table tmpНоменклатурнаяГруппа;


map_ВидСклада:
MAPPING LOAD * INLINE [
    _ParentID, ВидСклада
    80CA00155D0A560711E846F52AF4AD36, Магазины
    80CA00155D0A560711E846F52AF4AD37, Магазины
    80FE00155DFE050411EA798B4F4916A2, Магазины
    816200155DFE050411EB3E9F34006A04, Интернет-магазины
    B9A200155D1D6B2011ECFB9051699707, РЦ
    B9B500155D1D6B2011EDB28A2AFF5BF5, БРАК ТО
    B9EB00155DF9F40611EFC44D71F8C9F5, ВОЗВРАТ ТО];



////=====================================================================

//$tab Курсы------------------------------------------------------------------------------------

//=====================================================================
let DateStartA = MakeDate(2022,1,1);

Календарь:
LOAD
	DateId as 'Дата'
;
LOAD Date('$(DateStartA)' + IterNo() -1) as DateId
Autogenerate 1
While ('$(DateStartA)'+IterNo()-1)<'$(DateEnd)';
//=====================================================================
Валюта:
LOAD
    КодВалюты,
    Валюта
FROM [$(vQVDPath)/Справочники/Валюта.qvd](qvd)
where Валюта='EUR' or Валюта='USD';

left join(Валюта)
LOAD
    Дата,
    КодВалюты,
    Курс
FROM [$(vQVDPath)/РегистрыСведений/КурсыВалют.qvd](qvd);

Concatenate(Валюта)
LOAD
	Distinct
	Дата,
	'BYN' as Валюта,
	'8E8194DE804AB2E911E7B8A086220164' as КодВалюты,
	1 as Курс
Resident Календарь;

//===================================================================
store Валюта into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Валюта.qvd](qvd);
drop table Календарь,Валюта;
//===================================================================

//exit script;

//$tab Справочники------------------------------------------------------------------------------------

////=====================================================================
Склады:
LOAD
    КодСклад,
    КодСклад1C, //1C
    Склад,
    Город,
    НомерМагазинаВSetRetail as "Номер магазина",
    exist_TO,
    ApplyMap ('mapНаправление', КодНаправление,'Не определено') As Направление,
    ApplyMap ('mapРегион', КодРегион,'Не указан') As Регион,
    КатегорияМагазина,
    ApplyMap ('map_ВидСклада',[_ParentIDRRef],'Склад') as "Вид склада"
//     if(НомерМагазинаВSetRetail<>0 and (РЦПродукты=00 and РЦТовары=00),'Магазин',
//     	if(РЦПродукты=01 or РЦТовары=01,'РЦ',
//         	if(НомерМагазинаВSetRetail=0 and (РЦПродукты=00 and РЦТовары=00) and КодЦентральныйСклад='00000000000000000000000000000000','Склад',
//            		if(НомерМагазинаВSetRetail=0 and (РЦПродукты=00 and РЦТовары=00) and КодЦентральныйСклад<>'00000000000000000000000000000000','Подчиненные склады ')))) as "Вид склада"
FROM [$(vQVDPath)/Справочники/Склады.qvd](qvd);

left join(Склады)
LOAD
    КодОбъект as КодСклад,
    SubField(Значение3, ',', 1) as Широта,
    SubField(Значение3, ',', 2) as Долгота
FROM [$(vQVDPath)/РегистрыСведений/ЗначенияСвойствОбъектов.qvd](qvd)
where КодСвойство='B9B400155D1D6B2011EDA770C2408469' and Значение3<>'4819020390000'; //геоданные, с урезанием левых цифр

left join(Склады)
LOAD
    "Код магазина 1С" as КодСклад1C,
    "Ответственный за магазин" as "Ответственный за магазин (ТО)"
FROM [$(vExcelPath)/Ответственный за магазин (ТО).xlsx]
(ooxml, embedded labels, table is TDSheet);

LEFT JOIN (Склады)
LOAD
    "Номер магазина",
    Стеллажи,
    "S торг.",
    "S общая"
FROM [lib://Excel (fixmt_stefanovich)/Список_магазинов(ПХ).xlsx]
(ooxml, embedded labels, table is Лист);

LEFT JOIN (Склады)
LOAD
    "Номер магазина",
    "Менеджер товародвижения"
FROM [lib://Excel (fixmt_stefanovich)/МенеджерТовародвиженияТО.xlsx]
(ooxml, embedded labels, table is TDSheet);

//===================================================================
store Склады into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Склады.qvd](qvd);
Drop table Склады;
//===================================================================
НоменклатурныеГруппы:
LOAD
    КодНоменклатурнаяГруппа,
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5"
FROM [$(vQVDPath)/Справочники/НоменклатурныеГруппы.qvd]
(qvd);

//===================================================================
store НоменклатурныеГруппы into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/НоменклатурныеГруппы.qvd](qvd);
//===================================================================

Номенклатура:
LOAD
    КодНоменклатура,
    GUID_Номенклатура,
    КодТовара as "Код товара",
    Номенклатура as Товар,
    Артикул as "Артикул 1С",
    Номенклатура&' '&КодТовара as "Товар + Код",
    if(len(Trim(ТорговаяМарка))=0,'Не определен',ТорговаяМарка) as ТорговаяМарка,
    КодБренд,
    ApplyMap ('mapКонтрагент', КодОсновнойИзготовитель,'Не определен') As Производитель,
    ApplyMap ('mapВидНоменклатуры', КодВидНоменклатуры,
    	if(Match(ApplyMap('mapГруппаПоставщика', КодОсновнойПоставщик,'00000000000000000000000000000000'),'00000000000000000000000000000000') ,'Не заполнен',
   			 if(Match(ApplyMap('mapГруппаПоставщика', КодОсновнойПоставщик),'Поставщики  прод.товаров РБ','Поставщики тов. РБ'),'Товар РБ','Импортный'))) As "Вид номенклатуры",
    ApplyMap ('mapКонтрагент', КодОсновнойПоставщик,'Не определен') As ОсновнойПоставщик,
    ApplyMap ('mapШтрихкод', КодНоменклатура,'Не определен') As Штрихкод,
    КодНоменклатурнаяГруппа,
    ApplyMap ('mapПользователи', КодОтветственныйМенеджерЗаПокупки,'Не определен') As "Менеджер по закупкам",
    ApplyMap ('mapСтавкаНДС', КодСтавкаНДС,null()) As СтавкаНДС,
    ApplyMap ('mapNwpСтатусТовара', КодnwpСтатусТовара,null()) As "Статусы товаров",
    ApplyMap ('mapNwpСтатусТовараАктив', КодnwpСтатусТовара,null()) As АктивныйАссортимент,
    КотгрузкеВтипТО
FROM [$(vQVDPath)/Справочники/Номенклатура.qvd](qvd)
Where Exists(КодНоменклатурнаяГруппа); //Оставляем только Уровень=ТОВАРЫ

//===================================================================
store Номенклатура into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Номенклатура.qvd](qvd);
Drop Table НоменклатурныеГруппы;
//===================================================================
mapОсновнойПоставщик:
mapping load 
	КодНоменклатура,  
    ОсновнойПоставщик
Resident Номенклатура;
Drop table Номенклатура;
//===================================================================
Поставщики:
LOAD
    КодРодитель,
    УНП_Контрагент,
    Поставщик
FROM 
	[$(vQVDPath)/Справочники/Поставщики.qvd](qvd);

Left Join(Поставщики)
LOAD
	Coalesce(_Description5, Coalesce(_Description4, Coalesce(_Description3, Coalesce(_Description2, _Description1)))) as "Группа контрагентов (5 уровень)"
    ,Coalesce(_Description4, Coalesce(_Description3, Coalesce(_Description2, _Description1))) as "Группа контрагентов (4 уровень)"
    ,Coalesce(_Description3, Coalesce(_Description2,_Description1)) as "Группа контрагентов (3 уровень)"
    ,Coalesce(_Description2, _Description1) as "Группа контрагентов (2 уровень)"
    ,_Description1 as "Группа контрагентов (1 уровень)"
    ,КодКонтрагент as КодРодитель
FROM 
	[$(vQVDPath)/Справочники/Группы_Поставщиков.qvd](qvd);

store Поставщики into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Поставщики.qvd](qvd);
Drop Table Поставщики; 

//exit script;\

//$tab Остатки------------------------------------------------------------------------------------

////=====================================================================
Номенклатура: //Для верхнеуровневых qvd
LOAD
    КодНоменклатура,
    КодБренд,
    Производитель,
    "Вид номенклатуры",
    КодНоменклатурнаяГруппа,
    "Менеджер по закупкам",
    СтавкаНДС
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Номенклатура.qvd](qvd);

left join(Номенклатура)
LOAD
    КодНоменклатурнаяГруппа,
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5"
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/НоменклатурныеГруппы.qvd](qvd);



////=====================================================================
let DateLoadStart =DateStartStockDay;
let DateLoadEnd = DateEnd;
let IncPeriod = DateLoadStart;

do 

	let PeriodStart = IncPeriod;
	let PeriodEnd = AddMonths(IncPeriod, 1);
	let FileSuffix = Year(PeriodStart)&'_'&text(num(Month(PeriodStart),'00'));	
	
//===================================================================
if InRollBack or isnull(FileSize('$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Остатки/Остатки_$(FileSuffix).qvd')) then		
//===================================================================
TRACE 'Нижний уровень(ODAG) остатки $(FileSuffix)';	
//=================================

Остатки:
LOAD
    Дата,
    flgMinDate,
    flgMaxDate,
	КодНоменклатура,
    КодСклад,
    Поставщик,
    "#Остаток без НДС (с/с)",
    "#Остаток, шт.",
    "#Остаток, шт. начало",
    "#Остаток без НДС (с/с) начало"
FROM [$(vQVDPath)/Остатки/Остатки по дням/Stock_by_Day_$(FileSuffix).qvd](qvd)
where "#Остаток без НДС (с/с)"<>0 and "#Остаток, шт."<>0 and "#Остаток, шт. начало"<>0 and "#Остаток без НДС (с/с) начало"<>0;

////=====================================================================
let rowcount=NoOfRows('Остатки');
TRACE '======Строк в Остатки:'$(rowcount);
////=====================================================================

Left Join(Остатки)
IntervalMatch(Дата,КодНоменклатура,КодСклад)
LOAD
    ДатаСЦенаСклад,
    ДатаПоЦенаСклад,
    КодНоменклатура,
    КодСклад
FROM  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТСклад.qvd](qvd);

Left Join(Остатки)
LOAD               
    ДатаСЦенаСклад,
    ДатаПоЦенаСклад,
    КодНоменклатура,
    КодСклад,
    ЦенаРозничнаяСклад 
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТСклад.qvd](qvd);

////=====================================================================
let rowcount=NoOfRows('Остатки');
TRACE '======Строк в Остатки после джоина ЦеныАТТСклад:'$(rowcount);
////=====================================================================
Left Join(Остатки)
IntervalMatch(Дата,КодНоменклатура)
LOAD
    ДатаСЦенаКомпания,
    ДатаПоЦенаКомпания,
    КодНоменклатура
FROM  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТКомпания.qvd](qvd);

Left Join(Остатки)
LOAD               
    ДатаСЦенаКомпания,
    ДатаПоЦенаКомпания,
    КодНоменклатура,
    ЦенаРозничнаяКомпания 
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТКомпания.qvd](qvd);

////=====================================================================
let rowcount=NoOfRows('Остатки');
TRACE '======Строк в Остатки после джоина ЦеныАТТКомпания:'$(rowcount);
////=====================================================================

////===================================================================
store Остатки into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Остатки/Остатки_$(FileSuffix).qvd](qvd);
drop table Остатки;
//===================================================================
Остатки:
NoConcatenate LOAD
	Дата,
    flgMinDate,
    flgMaxDate,
    КодНоменклатура,
    КодСклад,
    Поставщик,
    "#Остаток без НДС (с/с)",
    "#Остаток, шт.",
    "#Остаток, шт. начало",
    "#Остаток без НДС (с/с) начало",   	
  	"#Остаток, шт."*if(isnull(ЦенаРозничнаяСклад),ЦенаРозничнаяКомпания,ЦенаРозничнаяСклад) as "#Остаток в розничных ценах с НДС"
From [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Остатки/Остатки_$(FileSuffix).qvd](qvd)
where "#Остаток без НДС (с/с)"<>0 and "#Остаток, шт."<>0 and "#Остаток, шт. начало"<>0 and "#Остаток без НДС (с/с) начало"<>0;
////===================================================================
store Остатки into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Остатки/Остатки_$(FileSuffix).qvd](qvd);
ENDIF
//===================================================================


//===================================================================
if InRollBack or isnull(FileSize('$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Остатки/ОстаткиKPI/ОстаткиKPI_$(FileSuffix).qvd')) then	
//===================================================================
TRACE 'Верхний уровень остатки KPI $(FileSuffix)';	
//=================================

left join(Остатки)
LOAD
    КодНоменклатура,
    КодБренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5",
    "Менеджер по закупкам",
    СтавкаНДС
Resident Номенклатура;

ОстаткиKPI:
NoConcatenate LOAD
    Date(floor(MonthEnd(Дата))) as Дата,
    КодБренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5",
    "Менеджер по закупкам",
    СтавкаНДС,
    КодСклад,
    Поставщик,
    Sum(if(flgMaxDate=1,"#Остаток, шт.")) as "#Остаток, шт.",    
    Sum(if(flgMaxDate=1,"#Остаток без НДС (с/с)")) as "#Остаток без НДС (с/с)",
    Sum(if(flgMaxDate=1,"#Остаток в розничных ценах с НДС")) as "#Остаток в розничных ценах с НДС",
    
    Sum(if(flgMinDate=1,"#Остаток, шт. начало")) as "#Остаток, шт. начало",
    Sum(if(flgMinDate=1,"#Остаток без НДС (с/с) начало")) as "#Остаток без НДС (с/с) начало",
        
    Sum("#Остаток, шт.") as "#Остаток, шт.(всего)",
    Sum("#Остаток без НДС (с/с)") as "#Остаток без НДС (с/c)(всего)",
    
        
    ((Sum(if(flgMinDate=1 or flgMaxDate=1,"#Остаток, шт."))/2)+
    	Sum(if(flgMinDate<>1 and flgMaxDate<>1,"#Остаток, шт.")))
        	/(Count(DISTINCT Дата)-1) as "#Средний товарный запас, шт. (количество)",
            
    ((Sum(if(flgMinDate=1 or flgMaxDate=1,"#Остаток без НДС (с/с)"))/2)+
    	Sum(if(flgMinDate<>1 and flgMaxDate<>1,"#Остаток без НДС (с/с)")))
        	/(Count(DISTINCT Дата)-1) as "#Средний товарный запас без НДС (c/c)",
    
    ((Sum(if(flgMinDate=1 or flgMaxDate=1,"#Остаток в розничных ценах с НДС"))/2)+
    	Sum(if(flgMinDate<>1 and flgMaxDate<>1,"#Остаток в розничных ценах с НДС")))
        	/(Count(DISTINCT Дата)-1) as "#Средний товарный запас в розничных ценах с НДС"          
Resident Остатки
Group by 
    Date(floor(MonthEnd(Дата))),
    КодБренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5",
    "Менеджер по закупкам",
    СтавкаНДС,
    КодСклад,
    Поставщик
   ;  

