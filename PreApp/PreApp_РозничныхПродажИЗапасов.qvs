// Group by 
//     Date(floor(MonthEnd(Дата))),
//     КодСклад,
//     КодНоменклатура;  

// Concatenate(ПродажиKPI)
// LOAD
//     Дата,
//     КодСклад,
//     Count(DISTINCT КодНоменклатура) as "#Количество уникальных SKU(Склады)"
