// Where "#Сумма реализации с НДС">0
// Group by 
// 	Дата,
//     КодСклад;  
// Drop table tmpSKU;    

//===================================================================
store ПродажиKPI into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/ПродажиKPI/ПродажиKPI_$(FileSuffix).qvd](qvd);
drop table Продажи,ПродажиKPI;
ENDIF
//===================================================================
let DateInc = timestamp(AddMonths(DateInc, 1));
LOOP while not InMonth(DateInc, DateLoadTo, 1);	
//===================================================================

//$tab Планы------------------------------------------------------------------------------------

//===================================================================
ПланУровеньГруппы1:
LOAD
    ГодМесяц&"Категория/Группа" as keyГодМесяцКатегория1,
    "Ликвидность (нижняя граница)" as "План.ЛиквидностьУр1 (нижняя граница)",
    "Ликвидность (верхняя граница)"  as "План.ЛиквидностьУр1 (верхняя граница)"    
FROM [$(vExcelPath)/План Ликвидность.xlsx]
(ooxml, embedded labels, table is [План Ликвидность]);

//===================================================================
store ПланУровеньГруппы1 into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ПланУровеньГруппы1.qvd](qvd);
Drop Table ПланУровеньГруппы1;
//===================================================================

ПланУровеньГруппы2:
LOAD
    ГодМесяц&Категория as keyГодМесяцКатегория2,
    "Выручка с НДС" as "План.Категория Выручка с НДС",
    Маржа as "План.Категория Маржа"
FROM [$(vExcelPath)/План Категории.xlsx]
(ooxml, embedded labels, table is [План Категории]);

Concatenate(ПланУровеньГруппы2)
LOAD
    ГодМесяц&"Категория/Группа" as keyГодМесяцКатегория2,
    "Ликвидность (нижняя граница)" as "План.ЛиквидностьУр2 (нижняя граница)",
    "Ликвидность (верхняя граница)"  as "План.ЛиквидностьУр2 (верхняя граница)"    
FROM [$(vExcelPath)/План Ликвидность.xlsx]
(ooxml, embedded labels, table is [План Ликвидность]);

//===================================================================
store ПланУровеньГруппы2 into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ПланУровеньГруппы2.qvd](qvd);
Drop Table ПланУровеньГруппы2;
//===================================================================

ПланСклады:
LOAD
	ГодМесяц&ApplyMap('mapКодСклад1C',"Код склада 1С",'Не определен') as keyГодМесяцСклад,
    "Выручка с НДС" as "План.Склад Выручка с НДС",
    Маржа as "План.Склад Маржа"
FROM [$(vExcelPath)/План ТО.xlsx]
(ooxml, embedded labels, table is [План ТО]);

//===================================================================
store ПланСклады into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ПланСклады.qvd](qvd);
Drop Table ПланСклады;
//===================================================================

//exit script;


