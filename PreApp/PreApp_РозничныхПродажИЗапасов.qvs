ENDIF
//===================================================================
let IncPeriod = AddMonths(IncPeriod, 1);
loop while not InMonth(IncPeriod, DateLoadEnd, 1);
////=====================================================================   
drop table Номенклатура; //tmpMaxDate;
//===================================================================

//exit script;

//$tab Продажи------------------------------------------------------------------------------------

////=====================================================================
НоменклатураTMP: //Оставляем только Уровень=ТОВАРЫ
NoConcatenate LOAD
    КодНоменклатура as КодНоменклатураTMP
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Номенклатура.qvd](qvd);
//===================================================================

let DateLoadStart =DateStart;
let DateLoadEnd = DateEnd;
let IncPeriod = DateLoadStart;

do 

	let PeriodStart = IncPeriod;
	let PeriodEnd = AddMonths(IncPeriod, 1);
	let FileSuffix = Year(PeriodStart)&'_'&text(num(Month(PeriodStart),'00'));	
	
	TRACE 'Calc period= $(FileSuffix)';
    
    if isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ТоварыВРознице/ТоварыВРознице_$(FileSuffix).qvd'))=0 then	

    ТоварыВРознице:
    LOAD
        Ссылка,
        НомерСтроки,
        ТипДокумент,
        Дата,
        КодНоменклатура,
        КодСклад,
        Количество,
        Стоимость,
        СуммаПродажная   
    FROM [$(vQVDPath)/РегистрыНакоплений/ТоварыВРознице/ТоварыВРознице_$(FileSuffix).qvd](qvd)
    Where Exists(КодНоменклатураTMP,КодНоменклатура);//Оставляем только Уровень=ТОВАРЫ
    
    endif
    
    if isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ПродажиОпт/ПродажиОпт_$(FileSuffix).qvd'))=0 then	    
    
    Опт:
    LOAD
        Дата,
        Ссылка,
        ТипДокумент,
        КодНоменклатура,
        НомерСтроки,
        Количество,
        Стоимость,
        СтоимостьБезСкидок
    FROM 
    	[$(vQVDPath)/РегистрыНакоплений/ПродажиОпт/ПродажиОпт_$(FileSuffix).qvd](qvd);
    
    endif
    
    Let vTableDoc = 'СуммаНДС:';
    
    if isnull(FileSize('$(vQVDPath)/Документы/ДокументРеализацияТоваровУслугТовары/ДокументРеализацияТоваровУслугТовары_$(FileSuffix).qvd'))=0 then	

    $(vTableDoc)
    LOAD
        Ссылка,
        КодНоменклатура,
        НомерСтроки,
        СуммаНДС,
        КодСклад
    FROM [$(vQVDPath)/Документы/ДокументРеализацияТоваровУслугТовары/ДокументРеализацияТоваровУслугТовары_$(FileSuffix).qvd](qvd);
    
    Let vTableDoc = 'Concatenate(СуммаНДС)';

    endif

    if isnull(FileSize('$(vQVDPath)/Документы/ДокументОтчетОРозничныхПродажахТовары/ДокументОтчетОРозничныхПродажахТовары_$(FileSuffix).qvd'))=0 then
    
    $(vTableDoc)
    LOAD
        Ссылка,
        КодНоменклатура,
        НомерСтроки,
        СуммаНДС
    FROM [$(vQVDPath)/Документы/ДокументОтчетОРозничныхПродажахТовары/ДокументОтчетОРозничныхПродажахТовары_$(FileSuffix).qvd](qvd);
    
    Let vTableDoc = 'Concatenate(СуммаНДС)';

    endif

    if isnull(FileSize('$(vQVDPath)/Документы/ДокументВозвратТоваровОтПокупателяТовары/ДокументВозвратТоваровОтПокупателяТовары_$(FileSuffix).qvd'))=0 then
    
    $(vTableDoc)
    LOAD
        Ссылка,
        КодНоменклатура,
        НомерСтроки,
        СуммаНДС,
        КодСклад
    FROM [$(vQVDPath)/Документы/ДокументВозвратТоваровОтПокупателяТовары/ДокументВозвратТоваровОтПокупателяТовары_$(FileSuffix).qvd](qvd);

    endif
	
let IncPeriod = AddMonths(IncPeriod, 1);
loop while not InMonth(IncPeriod, DateLoadEnd, 1);

//===================================================================
let rowcount=NoOfRows('ТоварыВРознице');
TRACE '======Строк ТоварыВРознице:'$(rowcount);
////=================================================================

left Join(ТоварыВРознице)
LOAD	  
 	Ссылка,
    КодНоменклатура,
    НомерСтроки,
    СуммаНДС
Resident СуммаНДС;

left Join(Опт)
LOAD	  
 	Ссылка,
    КодНоменклатура,
    НомерСтроки,
    СуммаНДС,
    КодСклад
Resident СуммаНДС;
Drop table СуммаНДС;

Concatenate(ТоварыВРознице)
LOAD
    Дата,
    Ссылка,
    ТипДокумент,
    КодНоменклатура,
    НомерСтроки,
    Количество,
    Стоимость,
    СтоимостьБезСкидок as СуммаПродажная,
    КодСклад,
    СуммаНДС
Resident
	Опт;

Drop Table Опт;
//===================================================================
let rowcount=NoOfRows('ТоварыВРознице');
TRACE '======Строк ТоварыВРознице после джоина СуммыНДС:'$(rowcount);
//===================================================================
store ТоварыВРознице into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpТоварыВРознице.qvd](qvd);
Drop table ТоварыВРознице;
////=================================================================

//$tab Поставщик|Себестоимость------------------------------------------------------------------------------------

////=====================================================================
mapПоставщик:
mapping load 
    Ссылка as КодДокументОприходования,
    ApplyMap ('mapКонтрагент', КодКонтрагента,'Не определен') As Поставщик
FROM [$(vQVDPath)/Документы/ПоступлениеТоваровИУслуг.qvd](qvd)
where Ссылка<>'00000000000000000000000000000000';
//===================================================================

let DateLoadStart =DateStart;
let DateLoadEnd = DateEnd;
let IncPeriod = DateLoadStart;

do 

	let PeriodStart = IncPeriod;
	let PeriodEnd = AddMonths(IncPeriod, 1);
	let FileSuffix = Year(PeriodStart)&'_'&text(num(Month(PeriodStart),'00'));	
	
	TRACE 'Calc period= $(FileSuffix)';  
    
    if isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ПартииТоваровНаСкладах/ПартииТоваровНаСкладах_$(FileSuffix).qvd'))=0 then

    ПартииТоваровНаСкладах:
    LOAD 
        Ссылка,
        ВидДвижения,
        ТипДокумент,
        Дата,
        КодНоменклатура,
        КодСклад,
        Hash128(Ссылка,КодНоменклатура) as keyСсылкаКодНоменклатура,
     	ApplyMap ('mapПоставщик', КодДокументОприходования,  ApplyMap ('mapОсновнойПоставщик', КодНоменклатура,'Не определен')) As Поставщик,
        ApplyMap ('mapОсновнойПоставщик', КодНоменклатура,'Не определен') As ОсновнойПоставщик,
        Количество,
        Себестоимость
    FROM [$(vQVDPath)/РегистрыНакоплений/ПартииТоваровНаСкладах/ПартииТоваровНаСкладах_$(FileSuffix).qvd](qvd)
    Where Exists(КодНоменклатураTMP,КодНоменклатура);//Оставляем только Уровень=ТОВАРЫ
	
    //На 1 строку в Рознице бывает 2 уник.поставшика, обработка и приоритет на основногопоставщика
	Left Join(ПартииТоваровНаСкладах)
    LOAD	  
        keyСсылкаКодНоменклатура,
        Count(Distinct Поставщик) as flgКолвоПоставщиков
    Resident ПартииТоваровНаСкладах
    Group by 
        keyСсылкаКодНоменклатура;
        
    ПартииТоваровНаСкладахПоставщик:
    LOAD	  
        Ссылка,
        ВидДвижения,
        ТипДокумент,
        Дата,
        КодНоменклатура,
        КодСклад,
        Количество,
        Себестоимость,	
        if(flgКолвоПоставщиков>1,ОсновнойПоставщик,Поставщик) As Поставщик
    Resident ПартииТоваровНаСкладах;
    Drop table ПартииТоваровНаСкладах;
    endif
	
let IncPeriod = AddMonths(IncPeriod, 1);
loop while not InMonth(IncPeriod, DateLoadEnd, 1);

//===================================================================
let rowcount=NoOfRows('ПартииТоваровНаСкладахПоставщик');
TRACE '======Строк ПартииТоваровНаСкладахПоставщик:'$(rowcount);
store ПартииТоваровНаСкладахПоставщик into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpПартииТоваровНаСкладах.qvd](qvd);
Drop table ПартииТоваровНаСкладахПоставщик,НоменклатураTMP;;
////=================================================================

//$tab Агрегация------------------------------------------------------------------------------------

////=====================================================================
//Агрегируем для подвязки себестоимости
Sales:
NoConcatenate LOAD
	Ссылка,
    ТипДокумент,
    Дата,
    КодНоменклатура,
    КодСклад,
    Sum(СуммаНДС) as СуммаНДС,
    Sum(Количество) as Количество,
    Sum(Стоимость) as Стоимость,
    Sum(СуммаПродажная) as СуммаПродажная   
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpТоварыВРознице.qvd](qvd)
group by
	Ссылка,
    ТипДокумент,
    Дата,
    КодНоменклатура,
    КодСклад;

//===================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк после агрегации Sales:'$(rowcount);
//===================================================================

left Join(Sales)
LOAD	  
 	Ссылка,
    КодНоменклатура,
    КодСклад,
    Поставщик,
    Sum(Количество) as Количество,
    Sum(Себестоимость) as  Себестоимость 
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpПартииТоваровНаСкладах.qvd](qvd)
group by 
	Ссылка,
    КодНоменклатура,
    КодСклад,
    Поставщик;
    
//===================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк в Sales после джоина ПартииТоваровНаСкладах:'$(rowcount);
//===================================================================    
//Добавляем Поступления
Concatenate(Sales)
LOAD	  
	Дата,
    КодНоменклатура,
    КодСклад,
    Поставщик,
    Sum(If(Match(ТипДокумент, '00000122', '00000110', '000000C5'), fabs(Количество))) as КоличествоПоступление,
    Sum(If(Match(ТипДокумент, '00000122', '00000110', '000000C5'), fabs(Себестоимость))) as  СебестоимостьПоступление 
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpПартииТоваровНаСкладах.qvd](qvd)
Where Match(ТипДокумент, '00000122', '00000110', '000000C5') and ВидДвижения=0
group by 
	Дата,
    КодНоменклатура,
    КодСклад,
    Поставщик
;
	    
//===================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк в Sales после добавления Поступлений:'$(rowcount);
//===================================================================    

//$tab Акции------------------------------------------------------------------------------------

////===================================================================
РекламнаяАкция:
LOAD
    Ссылка,
    ДатаНачалаРА,
    ДатаОкончанияРА
FROM [$(vQVDPath)/Документы/nwpРекламнаяАкция.qvd](qvd);

РекламнаяАкцияТовар:
LOAD Distinct
	Ссылка,
    КодНоменклатура
FROM [$(vQVDPath)/Документы/ДокументnwpРекламнаяАкцияТовары/ДокументnwpРекламнаяАкцияТовары_*.qvd](qvd) //ПЕРЕДЕЛАТЬ!!!!!
where Exists(Ссылка);

left join(РекламнаяАкция)
LOAD 
	Ссылка,
    КодНоменклатура
Resident РекламнаяАкцияТовар;
Drop table РекламнаяАкцияТовар;

//Есть двойные акции на товар(?), убираю обработку из-за которой замножения
// tmpРекламнаяАкция:
// NoConcatenate Load 
//     КодНоменклатура,
//     ДатаНачалаРА,
//     Date(Max(ДатаОкончанияРА)) as ДатаОкончанияРА
// Resident РекламнаяАкция
// Group By
//      КодНоменклатура,
//      ДатаНачалаРА
// Order By
//      КодНоменклатура,
//      ДатаНачалаРА Asc,
//      ДатаОкончанияРА Asc;     
// Drop Table РекламнаяАкция;
     
// РекламнаяАкция:
// NoConcatenate Load
//     КодНоменклатура,
//     If(КодНоменклатура = Previous(КодНоменклатура) and  Date(Floor(ДатаНачалаРА)) <= Previous(Date(Floor(ДатаОкончанияРА))),
//       Previous(Date(ДатаОкончанияРА + 1)), ДатаНачалаРА) as ДатаНачалаРА,
//     ДатаОкончанияРА
// Resident tmpРекламнаяАкция;   
// Drop Table tmpРекламнаяАкция;


//===================================================================
store РекламнаяАкция into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/РекламнаяАкция.qvd](qvd);
Drop table РекламнаяАкция;
//===================================================================

SalesDistinct:
NoConcatenate 
LOAD Distinct
    Дата,
    КодНоменклатура  
Resident Sales;

Left Join(SalesDistinct)
IntervalMatch(Дата,КодНоменклатура)
LOAD
    ДатаНачалаРА,
    ДатаОкончанияРА,
    КодНоменклатура
FROM  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/РекламнаяАкция.qvd](qvd);

Left Join(SalesDistinct)
LOAD
    КодНоменклатура,            
    ДатаНачалаРА,
    ДатаОкончанияРА,
    '1' as Акционность
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/РекламнаяАкция.qvd](qvd);

SalesАкционность:
NoConcatenate 
LOAD Distinct
	Дата,
    КодНоменклатура, 
    Акционность
Resident SalesDistinct;
Drop table SalesDistinct;

Left Join(Sales)
LOAD
    Дата,
    КодНоменклатура, 
    Акционность
Resident SalesАкционность;
Drop table SalesАкционность;

////===================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк в Sales после джоина Акции:'$(rowcount);
////===================================================================

//$tab Цены------------------------------------------------------------------------------------

////=====================================================================
//Обработка цен по Складам
tmpЦеныАТТСклад:
LOAD Distinct
    Дата,
    if(isnull(КодСклад) or КодСклад='00000000000000000000000000000000', ApplyMap ('mapСкладПереоценка', Ссылка,null()),КодСклад) as КодСклад,
    КодНоменклатура,
    Цена
FROM [$(vQVDPath)/РегистрыСведений/ЦеныАТТ.qvd](qvd);

ЦеныАТТСклад:
LOAD Distinct
    Дата as ДатаСЦенаСклад,
    If(КодСклад = Previous(КодСклад) and КодНоменклатура = Previous(КодНоменклатура),
        Previous(Date(Дата-1)), Today(1)) as ДатаПоЦенаСклад,
    КодНоменклатура,
    КодСклад,
    Цена as ЦенаРозничнаяСклад 	
Resident tmpЦеныАТТСклад
Order By
    КодНоменклатура,
    КодСклад,
    Дата Desc;
Drop Table tmpЦеныАТТСклад;

//===================================================================
store ЦеныАТТСклад into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТСклад.qvd](qvd);
Drop table ЦеныАТТСклад;
//===================================================================
//Обработка цен без складов, если нету цены Товара по складу, то берём последнюю текущую 
tmpЦеныАТТКомпания:
LOAD Distinct
    Дата,
    КодНоменклатура,
    Цена
FROM [$(vQVDPath)/РегистрыСведений/ЦеныАТТ.qvd](qvd);

ЦеныАТТКомпания:
LOAD Distinct
    Дата as ДатаСЦенаКомпания,
    If(КодНоменклатура = Previous(КодНоменклатура),
        Previous(Date(Дата-1)), Today(1)) as ДатаПоЦенаКомпания,
    КодНоменклатура,
    Цена as ЦенаРозничнаяКомпания 	
Resident tmpЦеныАТТКомпания
Order By
    КодНоменклатура,
    Дата Desc;
Drop Table tmpЦеныАТТКомпания;

//===================================================================
store ЦеныАТТКомпания into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТКомпания.qvd](qvd);
Drop table ЦеныАТТКомпания;
//===================================================================
//Джоины к транзакциям
Left Join(Sales)
IntervalMatch(Дата,КодНоменклатура,КодСклад)
LOAD
    ДатаСЦенаСклад,
    ДатаПоЦенаСклад,
    КодНоменклатура,
    КодСклад
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТСклад.qvd](qvd);

Left Join(Sales)
LOAD               
    ДатаСЦенаСклад,
    ДатаПоЦенаСклад,
    КодНоменклатура,
    КодСклад,
    ЦенаРозничнаяСклад 
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТСклад.qvd](qvd);

////=====================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк в Sales после джоина ЦеныАТТСклад:'$(rowcount);
////=====================================================================

Left Join(Sales)
IntervalMatch(Дата,КодНоменклатура)
LOAD
    ДатаСЦенаКомпания,
    ДатаПоЦенаКомпания,
    КодНоменклатура
FROM  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТКомпания.qvd](qvd);

Left Join(Sales)
LOAD               
    ДатаСЦенаКомпания,
    ДатаПоЦенаКомпания,
    КодНоменклатура,
    ЦенаРозничнаяКомпания 
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТКомпания.qvd](qvd);

////=====================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк в Sales после джоина ЦеныАТТКомпания:'$(rowcount);
////=====================================================================
store Sales into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpSales.qvd](qvd);
Drop table Sales;
////=====================================================================

//$tab Транзакции------------------------------------------------------------------------------------

////=====================================================================
Номенклатура: //Для верхнеуровневых qvd
LOAD
    КодНоменклатура,
    КодБренд,
    Производитель,
    "Вид номенклатуры",
    КодНоменклатурнаяГруппа,
    "Менеджер по закупкам",
    СтавкаНДС
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Номенклатура.qvd](qvd);

left join(Номенклатура)
LOAD
    КодНоменклатурнаяГруппа,
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5"
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/НоменклатурныеГруппы.qvd](qvd);
////=====================================================================

let DateInc=DateStart;
let DateLoadTo = DateEnd; 

do
	let DateFrom = DateInc; 
	let DateTo = MonthEnd(DateInc);
	let FileSuffix = Text(date(DateInc,'YYYY_MM'));
	let InRollBack  = (DateInc>=AddMonths(DateLoadTo, -RollBackMonthCount));

//===================================================================
if InRollBack or isnull(FileSize('$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/Продажи_$(FileSuffix).qvd')) then
//===================================================================
TRACE 'Нижний уровень(ODAG)' $(DateFrom) -- 	$(DateTo));	
//=================================

Продажи:
NoConcatenate LOAD 
    Date(floor(Дата)) as Дата,
    Date(Дата,'YYYY-MM')&КодСклад as keyГодМесяцСклад,
    Date(Дата,'YYYY-MM')&ApplyMap('mapНоменклатурнаяГруппа1',КодНоменклатура,'Не определен') as keyГодМесяцКатегория1,
    Date(Дата,'YYYY-MM')&ApplyMap('mapНоменклатурнаяГруппа2',КодНоменклатура,'Не определен') as keyГодМесяцКатегория2,
    КодНоменклатура,
    КодСклад,
    Поставщик,
    ТипДокумент,
    if(isnull(Акционность),0,Акционность) as Акционность,
    Sum(If(Match(ТипДокумент, '0000012B', '0000010E'), Количество)) as "#Объем реализации, шт",
	Sum(If(Match(ТипДокумент, '0000012B', '0000010E'), Стоимость)) as "#Сумма реализации с НДС",
    Sum(If(Match(ТипДокумент, '0000012B', '0000010E'), Стоимость-СуммаНДС)) as "#Сумма реализации без НДС",
    
    Sum(If(Match(ТипДокумент, '0000010E', '0000012B', '000000C5'), Себестоимость)) as "#Себестоимость без НДС",
    
    Sum(If(Match(ТипДокумент, '000000C5'), fabs(Количество))) as "#Объем возврата, шт.",
    Sum(If(Match(ТипДокумент, '000000C5'), fabs(Стоимость))) as "#Возвраты с НДС",
    Sum(If(Match(ТипДокумент, '000000C5'), fabs(Стоимость)-СуммаНДС)) as "#Возвраты без НДС",
       
    Sum(If(Match(ТипДокумент, '0000012B', '0000010E','000000C5'),СуммаПродажная-Стоимость)) as "#Сумма скидки",
    
    Avg(if(isnull(ЦенаРозничнаяСклад),ЦенаРозничнаяКомпания,ЦенаРозничнаяСклад)) as "#Цена розничная с НДС",
    
    Sum(КоличествоПоступление) as "#Поступление, шт.",
    Sum(СебестоимостьПоступление) as "#Поступление без НДС"
          
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpSales.qvd](qvd)
where Дата>=date('$(DateFrom)') and Дата<=date('$(DateTo)')
Group by 
    Дата,
    КодНоменклатура,
    КодСклад,
    Поставщик,
    ТипДокумент,
    Акционность
   ;  

//(Продажи) - к-во работающих ТО в день по категории 1
left join
LOAD
Дата,
keyГодМесяцКатегория1,
Count(distinct КодСклад) as qtyto 
Resident Продажи
where (ТипДокумент like '0000010E')
group by Дата, keyГодМесяцКатегория1
;

//===================================================================
store Продажи into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/Продажи_$(FileSuffix).qvd](qvd);
ENDIF
//===================================================================


//===================================================================
if InRollBack or isnull(FileSize('$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/ПродажиKPI/ПродажиKPI_$(FileSuffix).qvd')) then	
//===================================================================
TRACE 'Верхний уровень' $(DateFrom) -- 	$(DateTo));	
//=================================

left join(Продажи)
LOAD
    КодНоменклатура,
    КодБренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5",
    "Менеджер по закупкам",
    СтавкаНДС
Resident Номенклатура;

ПродажиKPI:
LOAD
    Date(floor(MonthEnd(Дата))) as Дата,
    keyГодМесяцСклад,
    keyГодМесяцКатегория1,
    keyГодМесяцКатегория2,
    КодБренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5",
    "Менеджер по закупкам",
    СтавкаНДС,
    КодСклад,
    Поставщик,
    Акционность,
    Sum("#Объем реализации, шт") as "#Объем реализации, шт",
    Sum("#Сумма реализации с НДС") as "#Сумма реализации с НДС",
    Sum("#Сумма реализации без НДС") as "#Сумма реализации без НДС",
    Sum("#Себестоимость без НДС") as "#Себестоимость без НДС",
    Sum("#Объем возврата, шт.") as "#Объем возврата, шт.",
    Sum("#Возвраты с НДС") as "#Возвраты с НДС",
    Sum("#Возвраты без НДС") as "#Возвраты без НДС",
    Sum("#Сумма скидки") as "#Сумма скидки",
    Avg("#Цена розничная с НДС") as "#Цена розничная с НДС",
    Sum("#Поступление, шт.") as "#Поступление, шт.",
    Sum("#Поступление без НДС") as "#Поступление без НДС"
Resident Продажи
Group by 
    Date(floor(MonthEnd(Дата))),
    keyГодМесяцСклад,
    keyГодМесяцКатегория1,
    keyГодМесяцКатегория2,
    КодБренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5",
    "Менеджер по закупкам",
    СтавкаНДС,
    КодСклад,
    Поставщик,
    Акционность
   ;  


// //=================================
