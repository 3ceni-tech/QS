//$tab Main------------------------------------------------------------------------------------

SET ThousandSep=' ';
SET DecimalSep=',';
SET MoneyThousandSep=' ';
SET MoneyDecimalSep=',';
SET MoneyFormat='# ##0,00 ₽;-# ##0,00 ₽';
SET TimeFormat='h:mm:ss';
SET DateFormat='DD.MM.YYYY';
SET TimestampFormat='DD.MM.YYYY h:mm:ss[.fff]';
SET FirstWeekDay=0;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='ru-RU';
SET CreateSearchIndexOnReload=1;
SET MonthNames='янв.;февр.;мар.;апр.;мая;июн.;июл.;авг.;сент.;окт.;нояб.;дек.';
SET LongMonthNames='январь;февраль;март;апрель;май;июнь;июль;август;сентябрь;октябрь;ноябрь;декабрь';
SET DayNames='пн;вт;ср;чт;пт;сб;вс';
SET LongDayNames='понедельник;вторник;среда;четверг;пятница;суббота;воскресенье';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';

//===================================================================
set vDBQvdPath=[lib://OLAP_FM/];
set vQVDPath=[lib://ETL_FM/];
set vExcelPath=[lib://Excel (fixmt_stefanovich)/];
//===============================1====================================
let FullReload=0; //Полная "1" или частичная "0" перегрузка
//===================================================================
//let DateStart=IF(FullReload=1,YearStart(AddYears(Today(1)-1,-2)),IF(match(num(WeekDay(today(2))),6),YearStart(AddYears(Today(1)-1,-2)),MonthStart(AddMonths(Today(1)-1,-3))));
//Let DateStartStockDay = IF(FullReload=1,YearStart(AddYears(Today(1)-1,-1)),IF(match(num(WeekDay(today(2))),6),YearStart(AddYears(Today(1)-1,-1)),MonthStart(AddMonths(Today(1)-1,-3))));
let DateStart = MakeDate(2023,1,1);
Let DateStartStockDay = MakeDate(2023,1,1);
let DateStartAll=MonthStart(AddYears(Today(1)-1,-23)); //Для расчётов требующих фулл период
let DateEnd=MonthEnd(Today(1)-1);
//let RollBackMonthCount =IF(FullReload=1,23,3);  
let RollBackMonthCount = IF(FullReload=1,23,IF(match(num(WeekDay(today(1))),6),23,3)); 

//===================================================================


//Exit script;


//$tab Mappings------------------------------------------------------------------------------------

////=====================================================================
mapТорговаяМарка:
mapping load 
	КодТМ,  
    ТорговаМарка
FROM [$(vQVDPath)/Справочники/ТорговыеМарки.qvd](qvd);

mapКонтрагент:
mapping load 
	КодКонтрагент,  
    Контрагент
FROM [$(vQVDPath)/Справочники/Контрагенты.qvd](qvd);

mapВидНоменклатуры:
mapping load
    КодВидНоменклатуры,
    ВидНоменклатуры
FROM [$(vQVDPath)/Справочники/ВидыНоменклатуры.qvd](qvd)
Where Match(ВидНоменклатуры,'Импортный','Товар РБ');

mapШтрихкод:
mapping load
    КодШтрихкод as КодНоменклатура,
    Штрихкод
FROM [$(vQVDPath)/РегистрыСведений/Штрихкоды.qvd](qvd);

mapПользователи:
mapping load 
	КодПользователь,  
    ИмяПользователя
FROM [$(vQVDPath)/Справочники/Пользователи.qvd](qvd);

mapСтавкаНДС:
mapping load 
    КодСтавкиНДС,
    СтавкаНДС
FROM [$(vQVDPath)/Справочники/СтавкиНДС.qvd](qvd);

mapГруппаПоставщика:
mapping load 
    КодКонтрагент as КодОсновнойПоставщик,
    ApplyMap ('mapКонтрагент', КодРодитель) as ГруппаКонтрагента    
FROM [$(vQVDPath)/Справочники/Контрагенты.qvd](qvd);

mapКодыОпераций:
mapping load 
    КодОперации,
    ОперацияДвиженияТМЦ
FROM [$(vQVDPath)/Перечисление/КодыОпераций.qvd](qvd);

mapСтраныПроизводителя:
mapping load 
    КодСтраныПроизводителя,
    СтранаПроизводителя
FROM [$(vQVDPath)/Справочники\СправочникСтраны.qvd](qvd);

////=====================================================================
//если в регистре поле Склад пустое, то это сигнал, что нужно проваливаться в Документ.ПереоценкаТоваровВРознице (_Document274)
mapСкладПереоценка:
mapping load 
	Ссылка,
    КодСклад
FROM [$(vQVDPath)Документы/ПереоценкаТоваровВРознице.qvd](qvd);
////=====================================================================

mapКодСклад1C:
mapping load
	КодСклад1C,
    КодСклад
FROM [$(vQVDPath)/Справочники/Склады.qvd](qvd);

mapКодСтрЕд:
mapping load
	КодСклад,
    КодСтрЕд
FROM [$(vQVDPath)/Справочники/Склады.qvd](qvd);

mapСкладДокРознПрод:
mapping Load
	[Ссылка],
    [КодСклад]
FROM [$(vQVDPath)Документы/РеализацияТоваровУслуг.qvd](qvd);

mapСкладВозврат:
mapping Load
	[Ссылка],
    [КодСклад]
FROM [$(vQVDPath)Документы/ВозвратТоваровОтПокупателя.qvd](qvd);
////=====================================================================


//Костыли из-за планов
tmpНоменклатурнаяГруппа:
NoConcatenate load 
    КодНоменклатура,
    КодНоменклатурнаяГруппа  
FROM [$(vQVDPath)/Справочники/Номенклатура.qvd](qvd);

left join(tmpНоменклатурнаяГруппа)
LOAD
    КодНоменклатурнаяГруппа,
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2"
FROM [$(vQVDPath)/Справочники/НоменклатурныеГруппы.qvd]
(qvd);

mapНоменклатурнаяГруппа1:
mapping load 
	КодНоменклатура,
    "Номенклатурная группа – Уровень 1"
resident tmpНоменклатурнаяГруппа;

mapНоменклатурнаяГруппа2:
mapping load 
	КодНоменклатура,
    "Номенклатурная группа – Уровень 2"
resident tmpНоменклатурнаяГруппа;
drop table tmpНоменклатурнаяГруппа;
////=====================================================================

mapСтатусТовара:
mapping load 
    [КодСтрЕд]&[КодНоменклатура],
    КодСтатусТовара // as "Статусы товаров"    
FROM [$(vQVDPath)/РегистрыСведений/СтатусыНоменклатурыФакт.qvd](qvd);

//$tab Курсы------------------------------------------------------------------------------------

//=====================================================================
Календарь:
LOAD
	DateId as 'Дата'
;
LOAD Date('$(DateStartAll)' + IterNo() -1) as DateId
Autogenerate 1
While ('$(DateStartAll)'+IterNo()-1)<'$(DateEnd)';
//=====================================================================
Валюта:
LOAD
    КодВалюты,
    Валюта
FROM [$(vQVDPath)/Справочники/Валюта.qvd](qvd)
where Валюта='EUR' or Валюта='USD';

left join(Валюта)
LOAD
    Дата,
    КодВалюты,
    Курс
FROM [$(vQVDPath)/РегистрыСведений/КурсыВалют.qvd](qvd);

Concatenate(Валюта)
LOAD
	Distinct
	Дата,
	'RUB' as Валюта,
	'831F00155D00024711EF34C0FACB0EEE' as КодВалюты,
	1 as Курс
Resident Календарь;

//===================================================================
store Валюта into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Валюта.qvd](qvd);
drop table Календарь,Валюта;
//===================================================================

//$tab Справочники------------------------------------------------------------------------------------

// ////=====================================================================
Склады:
LOAD
    КодСклад,
    КодСклад1C, //1C
    Склад,
    КодСтрЕд,
    if (Match(КодСтрЕд,'B9F400155D1D6B2011EF77103135D4CE','97873CECEF19CCC511F0672AE01913B0', '97843CECEF19CCC511F04B88660B7143')>0, 'РЦ',
      if(КодСтрЕд =	'831F00155D00024711EF3529B1F447B7', 'Склад',
        if (КодСклад1C = 1, 'Магазин', 'Подчиненные склады'))) as "Вид склада"
FROM [$(vQVDPath)/Справочники/Склады.qvd](qvd);

Left join(Склады)
Load
	КодСтрЕд,
    КодРегиона,
    НомерМагазинаВSetRetail,
    НомерМагазина as "Номер магазина",
    Наименование as Магазин,
    Широта,
    Долгота
FROM [$(vQVDPath)/Справочники/СтруктурныеЕдиницы.qvd](qvd);

Left join(Склады)
Load
	КодРегиона,
    Город
FROM [$(vQVDPath)/Справочники/Регионы.qvd](qvd);

left join(Склады)
LOAD
    "Номер магазина", //КодСтрЕд, // Заменить на НомерМагазина и в экселе ответственных сменить КодСтрЕд на НомерМагазина
    "Ответственный за магазин"
FROM [$(vExcelPath)/ОтветственныйЗаМагазин(ТО)RU.xlsx]
(ooxml, embedded labels, table is TDSheet);

LEFT JOIN (Склады)
LOAD
    № as "Номер магазина",
    Стеллажи,
    "S торг.",
    "S общая"
FROM [lib://Excel (fixmt_stefanovich)/Список_магазинов(ВБФМ).xlsx]
(ooxml, embedded labels, table is Лист);

Left join(Склады) 
Load
	КодСтрЕд,
    АссортSKU //К-во SKU в ассортименте структурной еденицы
FROM [$(vQVDPath)РегистрыСведений\Ассортимент.qvd](qvd);


//===================================================================
store Склады into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Склады.qvd](qvd);
Drop table Склады;


// //===================================================================
НоменклатурныеГруппы:
LOAD
    КодНоменклатурнаяГруппа,
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5"
FROM [$(vQVDPath)/Справочники/НоменклатурныеГруппы.qvd] (qvd);

// //===================================================================
store НоменклатурныеГруппы into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/НоменклатурныеГруппы.qvd](qvd);


// //===================================================================
Номенклатура:
LOAD
    КодНоменклатура,
    КодТовара as "Код товара",
    Номенклатура as Товар,
    Артикул as "Артикул 1С",
    Номенклатура&' '&КодТовара as "Товар + Код",
    ApplyMap ('mapТорговаяМарка', ТорговаяМарка,'Не определен') As Бренд,
    ApplyMap ('mapКонтрагент', КодОсновнойИзготовитель,'Не определен') As Производитель,
//     ApplyMap ('mapВидНоменклатуры', КодВидНоменклатуры,'Не заполнен') As "Вид номенклатуры",
    ApplyMap ('mapВидНоменклатуры', КодВидНоменклатуры,
    	if(Match(ApplyMap('mapГруппаПоставщика', КодОсновнойПоставщик,'00000000000000000000000000000000'),'00000000000000000000000000000000') ,'Не заполнен',
   			 if(Match(ApplyMap('mapГруппаПоставщика', КодОсновнойПоставщик),'Поставщики  прод.товаров РБ','Поставщики тов. РБ'),'Товар РБ','Импортный'))) As "Вид номенклатуры",
    ApplyMap ('mapКонтрагент', КодОсновнойПоставщик,'Не определен') As ОсновнойПоставщик,
    ApplyMap ('mapШтрихкод', КодНоменклатура,'Не определен') As Штрихкод,
    КодНоменклатурнаяГруппа,
    КодСтраныПроизводителя,
    ApplyMap ('mapСтраныПроизводителя', КодСтраныПроизводителя,'Не указана') As СтранаПроизводителя
//     ApplyMap ('mapПользователи', КодОтветственныйМенеджерЗаПокупки,'Не определен') As "Менеджер по закупкам"
//     ApplyMap ('mapСтавкаНДС', КодСтавкиНДС,null()) As СтавкаНДС
//    ApplyMap ('mapNwpСтатусТовара', КодnwpСтатусТовара,null()) As "Статусы товаров" 
FROM [$(vQVDPath)/Справочники/Номенклатура.qvd](qvd)
Where Exists(КодНоменклатурнаяГруппа); //Оставляем только Уровень=ТОВАРЫ
// //===================================================================
store Номенклатура into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Номенклатура.qvd](qvd);
Drop Table НоменклатурныеГруппы;


// //===================================================================
НоменклатураНДС:
Load
	Дата,
    КодНоменклатура,
    КодСтавкиНДС,
    ApplyMap('mapСтавкаНДС', КодСтавкиНДС, 'Не определен') As СтавкаНДС
FROM [$(vQVDPath)/РегистрыСведений/СтавкаНДС.qvd] (qvd);
// //===================================================================
store НоменклатураНДС into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/НоменклатураНДС.qvd](qvd);    
Drop Table НоменклатураНДС;	


// //===================================================================
mapОсновнойПоставщик:
mapping load 
	КодНоменклатура,  
    ОсновнойПоставщик
Resident Номенклатура;
Drop table Номенклатура;


// //===================================================================
Поставщики:
LOAD
    КодРодитель,
    КодКонтрагент,
    ИНН_Поставщик,
    Поставщик
FROM 
	[$(vQVDPath)/Справочники/Поставщики.qvd](qvd);

Left Join(Поставщики)
LOAD
// 	 Coalesce(_Description6, Coalesce(_Description5, Coalesce(_Description4, Coalesce(_Description3, Coalesce(_Description2, _Description1))))) as "Группа контрагентов (6 уровень)"
	 //Coalesce(_Description5, Coalesce(_Description4, Coalesce(_Description3, Coalesce(_Description2, _Description1)))) as "Группа контрагентов (5 уровень)"
  	//Coalesce(_Description4, Coalesce(_Description3, Coalesce(_Description2, _Description1))) as "Группа контрагентов (4 уровень)"
    Coalesce(_Description3, Coalesce(_Description2,_Description1)) as "Группа контрагентов (3 уровень)"
    ,Coalesce(_Description2, _Description1) as "Группа контрагентов (2 уровень)"
    ,_Description1 as "Группа контрагентов (1 уровень)"
    ,КодКонтрагент as КодРодитель
FROM 
	[$(vQVDPath)/Справочники/Группы_Поставщиков.qvd](qvd);

store Поставщики into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Поставщики.qvd](qvd);
Drop Table Поставщики;

// exit script;

//$tab Продажи------------------------------------------------------------------------------------

// ////=====================================================================
НоменклатураTMP: //Оставляем только Уровень=ТОВАРЫ
NoConcatenate LOAD
    КодНоменклатура as КодНоменклатураTMP
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Номенклатура.qvd](qvd);
//===================================================================

let DateLoadStart =DateStart;
let DateLoadEnd = DateEnd;
let IncPeriod = DateLoadStart;

do 

	let PeriodStart = IncPeriod;
	let PeriodEnd = AddMonths(IncPeriod, 1);
	let FileSuffix = Year(PeriodStart)&'_'&text(num(Month(PeriodStart),'00'));	
	
	TRACE 'Calc period= $(FileSuffix)';
    
    if isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ТоварыВРознице/ТоварыВРознице_$(FileSuffix).qvd'))=0 then	

    ТоварыВРознице:
    LOAD
        Дата,
        Ссылка,
        ТипДокумент,
        НомерСтроки,
        //Ссылка&НомерСтроки as KeyMovItem,
        КодНоменклатура,
        КодСклад,
        КодСтавкиНДС,
     	КодКонтрагент as Поставщик,
        Количество,
        СуммаПродажная,
        СуммаНДС,
       	Стоимость,
        СуммаНДСВх
    FROM [$(vQVDPath)/РегистрыНакоплений/ТоварыВРознице/ТоварыВРознице_$(FileSuffix).qvd](qvd);
    //Where Exists(КодНоменклатураTMP,КодНоменклатура); //Оставляем только Уровень=ТОВАРЫ
 

//         Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) as Дата,
//         Text(_RecorderRRef) as Ссылка,
//         Text(_RecorderTRef) as ТипДокумент,
//         text(_LineNo)       as НомерСтроки,
//         text(_Fld20406_RRRef) as КодНоменклатура,
//         text(_Fld20407RRef) as КодСклад,
//         text(_Fld20409RRef) as КодСтавкиНДС,
//         ApplyMap('mapКонтрагент', _Fld20411RRef) as Поставщик,
//         _Fld20418           as Количество,
//         _Fld20415           as СуммаПродажная,
//         _Fld20416			as СуммаНДС,
//         _Fld20417           as Стоимость,
//      	_Fld20419			as СуммаНДСВх
   
// 	FROM [$(vDBQvdPath)/_AccumRg/_AccumRg20403/_AccumRg20403_$(FileSuffix).qvd](qvd); 
 
 
    endif
    
	
let IncPeriod = AddMonths(IncPeriod, 1);
loop while not InMonth(IncPeriod, DateLoadEnd, 1);

// //===================================================================
store ТоварыВРознице into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpТоварыВРознице.qvd](qvd);
Drop table ТоварыВРознице;
////=================================================================
//exit script;

//$tab Поставщик|Себестоимость------------------------------------------------------------------------------------

////=====================================================================
// mapПоставщик:
// mapping load 
//     Ссылка,
//     ApplyMap ('mapКонтрагент', КодКонтрагент,'Не определен') As Поставщик
// FROM [$(vQVDPath)/Документы/ПоступлениеТоваровИУслуг.qvd](qvd)
// where Ссылка<>'00000000000000000000000000000000';

mapОсновнойПоставщик:
mapping load
	КодНоменклатура,  
 	КодОсновнойПоставщик
FROM [$(vQVDPath)/Справочники/НоменклатураКонтрагентов.qvd](qvd);

//===================================================================

let DateLoadStart =DateStart;
let DateLoadEnd = DateEnd;
let IncPeriod = DateLoadStart;

do 

	let PeriodStart = IncPeriod;
	let PeriodEnd = AddMonths(IncPeriod, 1);
	let FileSuffix = Year(PeriodStart)&'_'&text(num(Month(PeriodStart),'00'));	
	
	TRACE 'Calc period= $(FileSuffix)';  
    
    if isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ПартииТоваровНаСкладах/ПартииТоваровНаСкладах_$(FileSuffix).qvd'))=0 then

    ПартииТоваровНаСкладах:
    LOAD 
        Ссылка,
        ВидДвижения,
        ТипДокумент,
        Дата,
        КодНоменклатура,
        КодСклад,
        Hash128(Ссылка,КодНоменклатура) as keyСсылкаКодНоменклатура,
     	//ApplyMap ('mapПоставщик', Ссылка, 'Не определен') As Поставщик,
        КодКонтрагент As Поставщик,
        ApplyMap ('mapОсновнойПоставщик', КодНоменклатура,'Не определен') As ОсновнойПоставщик,
        Количество,
        СебестоимостьБНДС as Себестоимость,
        СуммаНДСсебес,
        ApplyMap ('mapКодыОпераций', КодОперации) as Операция
    FROM [$(vQVDPath)/РегистрыНакоплений/ПартииТоваровНаСкладах/ПартииТоваровНаСкладах_$(FileSuffix).qvd](qvd)
    Where Exists(КодНоменклатураTMP,КодНоменклатура);//Оставляем только Уровень=ТОВАРЫ
	
  //На 1 строку в Рознице бывает 2 уник.поставшика, обработка и приоритет на основногопоставщика
	Left Join(ПартииТоваровНаСкладах)
    LOAD	  
        keyСсылкаКодНоменклатура,
        Count(Distinct Поставщик) as flgКолвоПоставщиков
    Resident ПартииТоваровНаСкладах
    Group by 
        keyСсылкаКодНоменклатура;
        
    ПартииТоваровНаСкладахПоставщик:
    LOAD	  
        Ссылка,
        ВидДвижения,
        ТипДокумент,
        Дата,
        КодНоменклатура,
        КодСклад,
        Количество,
        Себестоимость,
        СуммаНДСсебес,
        if(flgКолвоПоставщиков>1,ОсновнойПоставщик,Поставщик) as Поставщик,
        Операция
    Resident ПартииТоваровНаСкладах;
    Drop table ПартииТоваровНаСкладах;
    endif
	
let IncPeriod = AddMonths(IncPeriod, 1);
loop while not InMonth(IncPeriod, DateLoadEnd, 1);

//===================================================================
let rowcount=NoOfRows('ПартииТоваровНаСкладахПоставщик');
TRACE '======Строк ПартииТоваровНаСкладахПоставщик:'$(rowcount);
store ПартииТоваровНаСкладахПоставщик into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpПартииТоваровНаСкладах.qvd](qvd);
Drop table ПартииТоваровНаСкладахПоставщик;;
////=================================================================

//$tab Агрегация------------------------------------------------------------------------------------

////=====================================================================
//Агрегируем для подвязки себестоимости
Sales:
NoConcatenate Load 
	Дата,
    Ссылка,
    ТипДокумент,
    КодНоменклатура,
    КодСклад,
    ApplyMap('mapСтавкаНДС',КодСтавкиНДС,0) as СтавкаНДС,
    Поставщик,
    Sum(Количество) as Количество,
    Sum(СуммаПродажная) as СуммаПродажная, 
    Sum(СуммаНДС) as СуммаНДС,
    Sum(СуммаПродажная-СуммаНДС) as СуммаБезНДС,
    Sum(Стоимость) as Стоимость
      
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpТоварыВРознице.qvd](qvd)
 group by
 	Дата,
    Ссылка,
    КодНоменклатура,
    КодСклад,
    КодСтавкиНДС,
    ТипДокумент,
    Поставщик;
  
//===================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк после агрегации Sales:'$(rowcount);
//===================================================================

left Join(Sales)
LOAD	  
 	Ссылка,
    КодНоменклатура,
    КодСклад,
    Поставщик,
    Операция,
    ТипДокумент,
    Sum(Количество) as Количество,
    Sum(Себестоимость) as  Стоимость,
    Sum(СуммаНДСсебес) as СуммаНДСсебес
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpПартииТоваровНаСкладах.qvd](qvd)
group by 
	Ссылка,
    КодНоменклатура,
    ТипДокумент,
    КодСклад,
    Операция,
    Поставщик;
    
//===================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк в Sales после джоина ПартииТоваровНаСкладах:'$(rowcount);
//===================================================================    
//Добавляем Поступления
// Документ.ПоступлениеТоваровИУслуг (_Document290) - 00000122 - Поступление товаров
// Документ.ПеремещениеТоваров (_Document272) - 00000110 - Перемещение
// Документ.ВозвратТоваровОтПокупателя (_Document197) - 000000C5 - Возврат от покупателя
Concatenate(Sales)
LOAD	  
	Дата,
    КодНоменклатура,
    КодСклад,
    Операция,
    ТипДокумент,
    Поставщик,
    Sum(If(Match(Операция, 'Поступление товаров', 'Перемещение', 'Возврат от покупателя'), fabs(Количество))) as КоличествоПоступление,
    Sum(If(Match(Операция, 'Поступление товаров', 'Перемещение', 'Возврат от покупателя'), fabs(Себестоимость))) as  СебестоимостьПоступление 
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpПартииТоваровНаСкладах.qvd](qvd)
Where Match(Операция, 'Поступление товаров', 'Перемещение', 'Возврат от покупателя') and ВидДвижения=0
group by 
	Дата,
    КодНоменклатура,
    КодСклад,
    Операция,
    ТипДокумент,
    Поставщик
;
	    
//===================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк в Sales после добавления Поступлений:'$(rowcount);
//===================================================================

//$tab Акции------------------------------------------------------------------------------------

////===================================================================
РекламнаяАкция:
LOAD
    Ссылка,
    ДатаНачалаРА,
    ДатаОкончанияРА
FROM [$(vQVDPath)/Документы/nwpРекламнаяАкция.qvd](qvd);

РекламнаяАкцияТовар:
LOAD Distinct
	Ссылка,
    КодНоменклатура
FROM [$(vQVDPath)/Документы/ДокументnwpРекламнаяАкцияТовары/ДокументnwpРекламнаяАкцияТовары_*.qvd](qvd) //ПЕРЕДЕЛАТЬ!!!!!
where Exists(Ссылка);

left join(РекламнаяАкция)
LOAD 
	Ссылка,
    КодНоменклатура
Resident РекламнаяАкцияТовар;
Drop table РекламнаяАкцияТовар;

//Есть двойные акции на товар(?), убираю обработку из-за которой замножения
// tmpРекламнаяАкция:
// NoConcatenate Load 
//     КодНоменклатура,
//     ДатаНачалаРА,
//     Date(Max(ДатаОкончанияРА)) as ДатаОкончанияРА
// Resident РекламнаяАкция
// Group By
//      КодНоменклатура,
//      ДатаНачалаРА
// Order By
//      КодНоменклатура,
//      ДатаНачалаРА Asc,
//      ДатаОкончанияРА Asc;     
// Drop Table РекламнаяАкция;
     
// РекламнаяАкция:
// NoConcatenate Load
//     КодНоменклатура,
//     If(КодНоменклатура = Previous(КодНоменклатура) and  Date(Floor(ДатаНачалаРА)) <= Previous(Date(Floor(ДатаОкончанияРА))),
//       Previous(Date(ДатаОкончанияРА + 1)), ДатаНачалаРА) as ДатаНачалаРА,
//     ДатаОкончанияРА
// Resident tmpРекламнаяАкция;   
// Drop Table tmpРекламнаяАкция;


//===================================================================
store РекламнаяАкция into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/РекламнаяАкция.qvd](qvd);
Drop table РекламнаяАкция;
//===================================================================

SalesDistinct:
NoConcatenate 
LOAD Distinct
    Дата,
    КодНоменклатура  
Resident Sales;

Left Join(SalesDistinct)
IntervalMatch(Дата,КодНоменклатура)
LOAD
    ДатаНачалаРА,
    ДатаОкончанияРА,
    КодНоменклатура
FROM  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/РекламнаяАкция.qvd](qvd);

Left Join(SalesDistinct)
LOAD
    КодНоменклатура,            
    ДатаНачалаРА,
    ДатаОкончанияРА,
    '1' as Акционность
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/РекламнаяАкция.qvd](qvd);

SalesАкционность:
NoConcatenate 
LOAD Distinct
	Дата,
    КодНоменклатура, 
    Акционность
Resident SalesDistinct;
Drop table SalesDistinct;

Left Join(Sales)
LOAD
    Дата,
    КодНоменклатура, 
    Акционность
Resident SalesАкционность;
Drop table SalesАкционность;

////===================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк в Sales после джоина Акции:'$(rowcount);
////===================================================================

//$tab Цены------------------------------------------------------------------------------------

////=====================================================================
//Обработка цен по Складам
tmpЦеныАТТСклад:
LOAD Distinct
    Дата,
    if(isnull(КодСклад) or КодСклад='00000000000000000000000000000000', ApplyMap ('mapСкладПереоценка', Ссылка,null()),КодСклад) as КодСклад,
    КодНоменклатура,
    Цена
FROM [$(vQVDPath)/РегистрыСведений/ЦеныАТТ.qvd](qvd);

ЦеныАТТСклад:
LOAD Distinct
    Дата as ДатаСЦенаСклад,
    If(КодСклад = Previous(КодСклад) and КодНоменклатура = Previous(КодНоменклатура),
        Previous(Date(Дата-1)), Today(1)) as ДатаПоЦенаСклад,
    КодНоменклатура,
    КодСклад,
    Цена as ЦенаРозничнаяСклад 	
Resident tmpЦеныАТТСклад
Order By
    КодНоменклатура,
    КодСклад,
    Дата Desc;
Drop Table tmpЦеныАТТСклад;

//===================================================================
store ЦеныАТТСклад into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТСклад.qvd](qvd);
Drop table ЦеныАТТСклад;
//===================================================================
//Обработка цен без складов, если нету цены Товара по складу, то берём последнюю текущую 
tmpЦеныАТТКомпания:
LOAD Distinct
    Дата,
    КодНоменклатура,
    Цена
FROM [$(vQVDPath)/РегистрыСведений/ЦеныАТТ.qvd](qvd);

ЦеныАТТКомпания:
LOAD Distinct
    Дата as ДатаСЦенаКомпания,
    If(КодНоменклатура = Previous(КодНоменклатура),
        Previous(Date(Дата-1)), Today(1)) as ДатаПоЦенаКомпания,
    КодНоменклатура,
    Цена as ЦенаРозничнаяКомпания 	
Resident tmpЦеныАТТКомпания
Order By
    КодНоменклатура,
    Дата Desc;
Drop Table tmpЦеныАТТКомпания;

//===================================================================
store ЦеныАТТКомпания into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТКомпания.qvd](qvd);
Drop table ЦеныАТТКомпания;
//===================================================================
//Джоины к транзакциям
Left Join(Sales)
IntervalMatch(Дата,КодНоменклатура,КодСклад)
LOAD
    ДатаСЦенаСклад,
    ДатаПоЦенаСклад,
    КодНоменклатура,
    КодСклад
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТСклад.qvd](qvd);

Left Join(Sales)
LOAD               
    ДатаСЦенаСклад,
    ДатаПоЦенаСклад,
    КодНоменклатура,
    КодСклад,
    ЦенаРозничнаяСклад 
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТСклад.qvd](qvd);

////=====================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк в Sales после джоина ЦеныАТТСклад:'$(rowcount);
////=====================================================================

Left Join(Sales)
IntervalMatch(Дата,КодНоменклатура)
LOAD
    ДатаСЦенаКомпания,
    ДатаПоЦенаКомпания,
    КодНоменклатура
FROM  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТКомпания.qvd](qvd);

Left Join(Sales)
LOAD               
    ДатаСЦенаКомпания,
    ДатаПоЦенаКомпания,
    КодНоменклатура,
    ЦенаРозничнаяКомпания 
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТКомпания.qvd](qvd);

////=====================================================================
let rowcount=NoOfRows('Sales');
TRACE '======Строк в Sales после джоина ЦеныАТТКомпания:'$(rowcount);
////=====================================================================
store Sales into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpSales.qvd](qvd);
Drop table Sales;
////=====================================================================

//$tab Транзакции------------------------------------------------------------------------------------

////=====================================================================
Номенклатура: //Для верхнеуровневых qvd
LOAD
    КодНоменклатура,
    Бренд,
    Производитель,
    "Вид номенклатуры",
    КодНоменклатурнаяГруппа
    //"Менеджер по закупкам",
    //СтавкаНДС
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Номенклатура.qvd](qvd);

left join(Номенклатура)
LOAD
    КодНоменклатурнаяГруппа,
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5"
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/НоменклатурныеГруппы.qvd](qvd);
////=====================================================================

let DateInc=DateStart;
let DateLoadTo = DateEnd; 

do
	let DateFrom = DateInc; 
	let DateTo = MonthEnd(DateInc);
	let FileSuffix = Text(date(DateInc,'YYYY_MM'));
	let InRollBack  = (DateInc>=AddMonths(DateLoadTo, -RollBackMonthCount));

//===================================================================
if InRollBack or isnull(FileSize('$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/Продажи_$(FileSuffix).qvd')) then
//===================================================================
TRACE 'Нижний уровень(ODAG)' $(DateFrom) -- 	$(DateTo));	
//=================================

Продажи:
NoConcatenate LOAD 
    Date(floor(Дата)) as Дата,
    Date(Дата,'YYYY-MM')&КодСклад as keyГодМесяцСклад,
    Date(Дата,'YYYY-MM')&ApplyMap('mapНоменклатурнаяГруппа1',КодНоменклатура,'Не определен') as keyГодМесяцКатегория1,
    Date(Дата,'YYYY-MM')&ApplyMap('mapНоменклатурнаяГруппа2',КодНоменклатура,'Не определен') as keyГодМесяцКатегория2,
    Операция,
    ТипДокумент,
    КодНоменклатура,
    КодСклад,
    ApplyMap('mapСтатусТовара', ApplyMap ('mapКодСтрЕд', КодСклад)&[КодНоменклатура], 0) As КодСтатусТовара,
    Поставщик,
    if(СтавкаНДС = ('00000000000000000000000000000000') OR isnull(СтавкаНДС), 0, СтавкаНДС) as СтавкаНДС, 
    if(isnull(Акционность),0,Акционность) as Акционность,
    Sum(If(Match(Операция, 'Продажа в розницу','Продажа оптом'), Количество)) as "#Объем реализации, шт",
	Sum(If(Match(Операция, 'Продажа в розницу','Продажа оптом'), СуммаПродажная)) as "#Сумма реализации с НДС",
    Sum(If(Match(Операция, 'Продажа в розницу','Продажа оптом'), СуммаБезНДС)) as "#Сумма реализации без НДС",
    Sum(If(Match(Операция, 'Продажа в розницу','Продажа оптом'), Стоимость)) as "#Себестоимость без НДС",
    Sum(If(Match(Операция, 'Продажа в розницу','Продажа оптом'), Стоимость))*(1+СтавкаНДС/100) as "#Себестоимость c НДС",
    Sum(If(Match(Операция, 'Возврат от покупателя'), КоличествоПоступление)) as "#Объем возврата, шт.",
    Sum(If(Match(Операция, 'Возврат от покупателя'), СебестоимостьПоступление*КоличествоПоступление)) as "#Возвраты без НДС",
    Sum(If(Match(Операция, 'Возврат от покупателя'), СебестоимостьПоступление*КоличествоПоступление))*(1+СтавкаНДС/100) as "#Возвраты c НДС",
    //Sum(If(Match(Операция, 'Возврат от покупателя'), fabs(Стоимость)-СуммаНДС)) as "#Возвраты без НДС",
       
    //Sum(If(Match(Операция, '0000012B', '0000010E','000000C5'),СуммаПродажная-Стоимость)) as "#Сумма скидки",
    
    Avg(if(isnull(ЦенаРозничнаяСклад),ЦенаРозничнаяКомпания,ЦенаРозничнаяСклад)) as "#Цена розничная с НДС",
    
    Sum(If(Match(Операция, 'Поступление товаров'), КоличествоПоступление)) as "#Поступление, шт.",
    Sum(If(Match(Операция, 'Поступление товаров'), СебестоимостьПоступление*КоличествоПоступление)) as "#Поступление без НДС"
          
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/TEMP/tmpSales.qvd](qvd)
where Дата>=date('$(DateFrom)') and Дата<=date('$(DateTo)')
Group by 
    Дата,
    КодНоменклатура,
    Операция,
    ТипДокумент,
    КодСклад,
    Поставщик,
    СтавкаНДС,
    Акционность
   ; 
   

//(Продажи) - к-во работающих ТО в день по категории 1
left join
LOAD
Дата,
keyГодМесяцКатегория1,
Count(distinct КодСклад) as qtyto 
Resident Продажи
where ([Операция] like 'Продажа в розницу')
group by Дата, keyГодМесяцКатегория1
;   


//===================================================================
store Продажи into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/Продажи_$(FileSuffix).qvd](qvd);
ENDIF
//===================================================================


//===================================================================
if InRollBack or isnull(FileSize('$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/ПродажиKPI/ПродажиKPI_$(FileSuffix).qvd')) then	
//===================================================================
TRACE 'Верхний уровень' $(DateFrom) -- 	$(DateTo));	
//=================================

left join(Продажи)
LOAD
    КодНоменклатура,
    Бренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5"
    //"Менеджер по закупкам",
    //СтавкаНДС
Resident Номенклатура;

ПродажиKPI:
LOAD
    //Date(floor(MonthEnd(Дата))) as Дата,
    Date(floor(Дата)) as Дата,
    keyГодМесяцСклад,
    keyГодМесяцКатегория1,
    keyГодМесяцКатегория2,
    Бренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5",
    //"Менеджер по закупкам",
    //СтавкаНДС,
    КодСклад,
    Поставщик,
    СтавкаНДС,
    Акционность,
    Sum("#Объем реализации, шт") as "#Объем реализации, шт",
    Sum("#Сумма реализации с НДС") as "#Сумма реализации с НДС",
    Sum("#Сумма реализации без НДС") as "#Сумма реализации без НДС",
    Sum("#Себестоимость без НДС") as "#Себестоимость без НДС",
    Sum("#Объем возврата, шт.") as "#Объем возврата, шт.",
    //Sum("#Возвраты с НДС") as "#Возвраты с НДС",
    Sum("#Возвраты без НДС") as "#Возвраты без НДС",
    //Sum("#Сумма скидки") as "#Сумма скидки",
    Avg("#Цена розничная с НДС") as "#Цена розничная с НДС",
    Sum("#Поступление, шт.") as "#Поступление, шт.",
    Sum("#Поступление без НДС") as "#Поступление без НДС"
Resident Продажи
Group by 
    //Date(floor(MonthEnd(Дата))),
    Date(floor(Дата)),
    keyГодМесяцСклад,
    keyГодМесяцКатегория1,
    keyГодМесяцКатегория2,
    Бренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5",
    //"Менеджер по закупкам",
    СтавкаНДС,
    КодСклад,
    Поставщик,
    Акционность
   ;  


// //=================================
// tmpSKU:
// NoConcatenate LOAD
//     Date(floor(MonthEnd(Дата))) as Дата,
//     КодНоменклатура,
//     Sum("#Сумма реализации с НДС") as "#Сумма реализации с НДС"
// Resident Продажи
// Group by 
//     Date(floor(MonthEnd(Дата))),
//     КодНоменклатура;  

// Concatenate(ПродажиKPI)
// LOAD
//     Дата,
//     Count(DISTINCT КодНоменклатура) as "#Количество уникальных SKU(компания)"
// Resident tmpSKU
// Where "#Сумма реализации с НДС">0
// Group by 
// 	Дата;  
