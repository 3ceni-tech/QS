//===================================================================
store ПродажиKPI into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Транзакции/ПродажиKPI/ПродажиKPI_$(FileSuffix).qvd](qvd);
drop table Продажи,ПродажиKPI;
ENDIF
//===================================================================
let DateInc = timestamp(AddMonths(DateInc, 1));
LOOP while not InMonth(DateInc, DateLoadTo, 1);	
//===================================================================
//exit Script;

//$tab Остатки------------------------------------------------------------------------------------

////=====================================================================
//let DateLoadStart = DateStartStockDay;
let DateLoadStart = '2024-01-01';
let DateLoadEnd = DateEnd;
let IncPeriod = DateLoadStart;

do 

	let PeriodStart = IncPeriod;
	let PeriodEnd = AddMonths(IncPeriod, 1);
	let FileSuffix = Year(PeriodStart)&'_'&text(num(Month(PeriodStart),'00'));	
	
//===================================================================
if InRollBack or isnull(FileSize('$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Остатки/Остатки_$(FileSuffix).qvd')) then		
//===================================================================
TRACE 'Нижний уровень(ODAG) остатки $(FileSuffix)';	
//=================================

Остатки:
LOAD
    Дата,
    flgMinDate,
    flgMaxDate,
	КодНоменклатура,
    КодСклад,
    ApplyMap('mapСтатусТовара', ApplyMap ('mapКодСтрЕд', КодСклад)&[КодНоменклатура], 0) As КодСтатусТовара,
    Поставщик,
    "#Остаток без НДС (с/с)",
    "#Остаток, шт.",
    "#Остаток, шт. начало",
    "#Остаток без НДС (с/с) начало"
FROM [$(vQVDPath)/Остатки/Остатки по дням/Stock_by_Day_$(FileSuffix).qvd](qvd);

////=====================================================================
let rowcount=NoOfRows('Остатки');
TRACE '======Строк в Остатки:'$(rowcount);
////=====================================================================

Left Join(Остатки)
IntervalMatch(Дата,КодНоменклатура,КодСклад)
LOAD
    ДатаСЦенаСклад,
    ДатаПоЦенаСклад,
    КодНоменклатура,
    КодСклад
FROM  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТСклад.qvd](qvd);

Left Join(Остатки)
LOAD               
    ДатаСЦенаСклад,
    ДатаПоЦенаСклад,
    КодНоменклатура,
    КодСклад,
    ЦенаРозничнаяСклад 
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТСклад.qvd](qvd);

////=====================================================================
let rowcount=NoOfRows('Остатки');
TRACE '======Строк в Остатки после джоина ЦеныАТТСклад:'$(rowcount);
////=====================================================================
Left Join(Остатки)
IntervalMatch(Дата,КодНоменклатура)
LOAD
    ДатаСЦенаКомпания,
    ДатаПоЦенаКомпания,
    КодНоменклатура
FROM  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТКомпания.qvd](qvd);

Left Join(Остатки)
LOAD               
    ДатаСЦенаКомпания,
    ДатаПоЦенаКомпания,
    КодНоменклатура,
    ЦенаРозничнаяКомпания 
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ЦеныАТТКомпания.qvd](qvd);

////=====================================================================
let rowcount=NoOfRows('Остатки');
TRACE '======Строк в Остатки после джоина ЦеныАТТКомпания:'$(rowcount);
////=====================================================================

////===================================================================
store Остатки into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Остатки/Остатки_$(FileSuffix).qvd](qvd);
drop table Остатки;
//===================================================================
Остатки:
NoConcatenate LOAD
	Дата,
    flgMinDate,
    flgMaxDate,
    КодНоменклатура,
    КодСклад,
    Поставщик,
	КодСтатусТовара,
    "#Остаток без НДС (с/с)",
    "#Остаток, шт.",
    "#Остаток, шт. начало",
    "#Остаток без НДС (с/с) начало",   	
  	"#Остаток, шт."*if(isnull(ЦенаРозничнаяСклад),ЦенаРозничнаяКомпания,ЦенаРозничнаяСклад) as "#Остаток в розничных ценах с НДС"
From [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Остатки/Остатки_$(FileSuffix).qvd](qvd);  
////===================================================================
store Остатки into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Остатки/Остатки_$(FileSuffix).qvd](qvd);
ENDIF
//===================================================================


//===================================================================
if InRollBack or isnull(FileSize('$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Остатки/ОстаткиKPI/ОстаткиKPI_$(FileSuffix).qvd')) then	
//===================================================================
TRACE 'Верхний уровень остатки $(FileSuffix)';	
//=================================

left join(Остатки)
LOAD
    КодНоменклатура,
    Бренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5"
    //"Менеджер по закупкам",
    //СтавкаНДС
Resident Номенклатура;

ОстаткиKPI:
NoConcatenate LOAD
    Date(floor(MonthEnd(Дата))) as Дата,
    Бренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5",
    //"Менеджер по закупкам",
    //СтавкаНДС,
    КодСклад,
    Поставщик,
    Sum(if(flgMaxDate=1,"#Остаток, шт.")) as "#Остаток, шт.",    
    Sum(if(flgMaxDate=1,"#Остаток без НДС (с/с)")) as "#Остаток без НДС (с/с)",
    Sum(if(flgMaxDate=1,"#Остаток в розничных ценах с НДС")) as "#Остаток в розничных ценах с НДС",
    
    Sum(if(flgMinDate=1,"#Остаток, шт. начало")) as "#Остаток, шт. начало",
    Sum(if(flgMinDate=1,"#Остаток без НДС (с/с) начало")) as "#Остаток без НДС (с/с) начало",
        
    Sum("#Остаток, шт.") as "#Остаток, шт.(всего)",
    Sum("#Остаток без НДС (с/с)") as "#Остаток без НДС (с/c)(всего)",
    
        
    ((Sum(if(flgMinDate=1 or flgMaxDate=1,"#Остаток, шт."))/2)+
    	Sum(if(flgMinDate<>1 and flgMaxDate<>1,"#Остаток, шт.")))
        	/(Count(DISTINCT Дата)-1) as "#Средний товарный запас, шт. (количество)",
            
    ((Sum(if(flgMinDate=1 or flgMaxDate=1,"#Остаток без НДС (с/с)"))/2)+
    	Sum(if(flgMinDate<>1 and flgMaxDate<>1,"#Остаток без НДС (с/с)")))
        	/(Count(DISTINCT Дата)-1) as "#Средний товарный запас без НДС (c/c)",
    
    ((Sum(if(flgMinDate=1 or flgMaxDate=1,"#Остаток в розничных ценах с НДС"))/2)+
    	Sum(if(flgMinDate<>1 and flgMaxDate<>1,"#Остаток в розничных ценах с НДС")))
        	/(Count(DISTINCT Дата)-1) as "#Средний товарный запас в розничных ценах с НДС"          
Resident Остатки
Group by 
    Date(floor(MonthEnd(Дата))),
    Бренд,
    Производитель,
    "Вид номенклатуры",
    "Номенклатурная группа – Уровень 1",
    "Номенклатурная группа – Уровень 2",
    "Номенклатурная группа – Уровень 3",
    "Номенклатурная группа – Уровень 4",
    "Номенклатурная группа – Уровень 5",
    //"Менеджер по закупкам",
    //СтавкаНДС,
    КодСклад,
    Поставщик
   ;  

// //=================================
// tmpSKU:
// NoConcatenate LOAD
// 	Date(floor(MonthEnd(Дата))) as Дата,
//     КодНоменклатура,
//     Sum("#Остаток, шт.") as "#Остаток, шт."
// Resident Остатки
// where flgMaxDate=1
// Group by
// 	Date(floor(MonthEnd(Дата))),
//     КодНоменклатура;

// Concatenate(ОстаткиKPI)
// LOAD
//     Дата,
//     Count(DISTINCT  КодНоменклатура) as "#Кол-во SKU на остатке(компания)"
// Resident tmpSKU
// Where "#Остаток, шт.">0
// Group by 
//     Дата;  
// Drop table tmpSKU;   
// //=================================
// tmpSKU:
// NoConcatenate LOAD
// 	Date(floor(MonthEnd(Дата))) as Дата,
//     КодНоменклатура,
//     КодСклад,
//     Sum("#Остаток, шт.") as "#Остаток, шт."
// Resident Остатки
// where flgMaxDate=1
// Group by
// 	Date(floor(MonthEnd(Дата))),
//     КодНоменклатура,
//     КодСклад;
       
// Concatenate(ОстаткиKPI)
// LOAD
//     Дата,
//     КодСклад,
//     Count(DISTINCT КодНоменклатура) as "#Кол-во SKU на остатке(Склады)"
// Resident tmpSKU
// Where "#Остаток, шт.">0
// Group by 
//     Дата,
//     КодСклад;  
// Drop table tmpSKU;

//===================================================================
store ОстаткиKPI into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Остатки/ОстаткиKPI/ОстаткиKPI_$(FileSuffix).qvd](qvd);
drop table Остатки,ОстаткиKPI;
ENDIF
//===================================================================
let IncPeriod = AddMonths(IncPeriod, 1);
loop while not InMonth(IncPeriod, DateLoadEnd, 1);
////=====================================================================   
drop table Номенклатура; //tmpMaxDate;
//===================================================================

//$tab Планы------------------------------------------------------------------------------------

mapСклады:
mapping load 
	"Номер магазина",
    КодСклад    
FROM [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/Склады.qvd](qvd)
WHERE КодСклад1C = 1;

//===================================================================
ПланУровеньГруппы1:
LOAD
    ГодМесяц&"Категория/Группа" as keyГодМесяцКатегория1,
    "Ликвидность (нижняя граница)" as "План.ЛиквидностьУр1 (нижняя граница)",
    "Ликвидность (верхняя граница)"  as "План.ЛиквидностьУр1 (верхняя граница)"    
FROM [$(vExcelPath)/ПланЛиквидностьRU.xlsx]
(ooxml, embedded labels, table is [План Ликвидность]);

//===================================================================
store ПланУровеньГруппы1 into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ПланУровеньГруппы1.qvd](qvd);
Drop Table ПланУровеньГруппы1;
//===================================================================

ПланУровеньГруппы2:
LOAD
    ГодМесяц&Категория as keyГодМесяцКатегория2,
    "Выручка с НДС" as "План.Категория Выручка с НДС",
    Маржа as "План.Категория Маржа"
FROM [$(vExcelPath)/ПланКатегорииRU.xlsx]
(ooxml, embedded labels, table is [План Категории]);

Concatenate(ПланУровеньГруппы2)
LOAD
    ГодМесяц&"Категория/Группа" as keyГодМесяцКатегория2,
    "Ликвидность (нижняя граница)" as "План.ЛиквидностьУр2 (нижняя граница)",
    "Ликвидность (верхняя граница)"  as "План.ЛиквидностьУр2 (верхняя граница)"    
FROM [$(vExcelPath)/ПланЛиквидностьRU.xlsx]
(ooxml, embedded labels, table is [План Ликвидность]);

//===================================================================
store ПланУровеньГруппы2 into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ПланУровеньГруппы2.qvd](qvd);
Drop Table ПланУровеньГруппы2;
//===================================================================

ПланСклады:
LOAD
	ГодМесяц&ApplyMap('mapСклады',"Номер магазина",'Не определен') as keyГодМесяцСклад,
    "Выручка с НДС" as "План.Склад Выручка с НДС",
    Маржа as "План.Склад Маржа"
FROM [$(vExcelPath)/ПланТОRU.xlsx]
(ooxml, embedded labels, table is [План ТО]);

//===================================================================
store ПланСклады into  [$(vQVDPath)/PreApp/Анализ розничных продаж и запасов/Tables/ПланСклады.qvd](qvd);
Drop Table ПланСклады;
//===================================================================

