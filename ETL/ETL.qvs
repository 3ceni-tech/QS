nwpРекламнаяАкция:
LOAD
	Text(_IDRRef) as Ссылка,
    Date#(Date(AddYears(_Fld7736,-2000),'DD.MM.YYYY')) as ДатаНачалаРА,
    Date#(Date(AddYears(_Fld7737,-2000),'DD.MM.YYYY')) as ДатаОкончанияРА,
    _Fld7738RRef as КодСтатусРА
FROM [$(vDBQvdPath)/_Document/_Document383.qvd](qvd)
where _Posted=01 and _Marked=00 and _Fld7742<>'удалена';

store nwpРекламнаяАкция into  [$(vQVDPath)Документы\nwpРекламнаяАкция.qvd](qvd);
drop table nwpРекламнаяАкция;

