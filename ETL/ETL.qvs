ПереоценкаТоваровВРознице:
LOAD
	'ПереоценкаТоваровВРознице' as Документ,
	Text(_IDRRef) as Ссылка,
    _Fld3837RRef as КодСклад
FROM [$(vDBQvdPath)/_Document/_Document274.qvd](qvd);

store ПереоценкаТоваровВРознице into  [$(vQVDPath)Документы\ПереоценкаТоваровВРознице.qvd](qvd);
drop table ПереоценкаТоваровВРознице;

//$tab ДокументыСостав----------------------------------------------------------------------
/*
Документ.РеализацияТоваровУслуг.Товары (_Document299_VT5114)		
Документ.ОтчетОРозничныхПродажах.Товары (_Document270_VT3640)		
Документ.ВозвратТоваровОтПокупателя.Товары (_Document197_VT1211)    
*/
let DateInc = DateStart;
let DateLoadTo = DateFinish; 
do
	let DateFrom = DateInc; 
	let DateTo = MonthEnd(DateInc);
	let DateToSQL = date(MonthEnd(DateInc)+1);
	let FileSuffix = Text(date(AddYears(DateInc,-2000),'YYYY_MM'));
	let InRollBack  = (DateInc>=AddMonths(DateLoadTo, -RollBackMonthCount));

    if InRollBack or isnull(FileSize('$(vQVDPath)/Документы/ДокументРеализацияТоваровУслугТовары/ДокументРеализацияТоваровУслугТовары_$(FileSuffix).qvd')) then

    TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

    ДокументРеализацияТоваровУслугТовары:
    LOAD
        Text(_Document299_IDRRef) as Ссылка,
        text(_Fld5122RRef)        as КодНоменклатура,
        _LineNo5115               as НомерСтроки,
        _Fld5128                  as СуммаНДС,
        Text(_Fld5057RRef)        as КодСклад
    FROM [$(vDBQvdPath)/_Document/_Document299_VT5114/_Document299_VT5114_$(FileSuffix).qvd](qvd);

    store ДокументРеализацияТоваровУслугТовары into  [$(vQVDPath)/Документы/ДокументРеализацияТоваровУслугТовары/ДокументРеализацияТоваровУслугТовары_$(FileSuffix).qvd](qvd);
    DROP Tables ДокументРеализацияТоваровУслугТовары;

    end if

    if InRollBack or isnull(FileSize('$(vQVDPath)/Документы/ДокументОтчетОРозничныхПродажахТовары/ДокументОтчетОРозничныхПродажахТовары_$(FileSuffix).qvd')) then

    TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

    ДокументОтчетОРозничныхПродажахТовары:
    LOAD
        Text(_Document270_IDRRef) as Ссылка,
        text(_Fld3642RRef) as КодНоменклатура,
        _LineNo3641 as НомерСтроки,
        _Fld3653 as СуммаНДС
    FROM [$(vDBQvdPath)/_Document/_Document270_VT3640/_Document270_VT3640_$(FileSuffix).qvd](qvd);

    store ДокументОтчетОРозничныхПродажахТовары into  [$(vQVDPath)/Документы/ДокументОтчетОРозничныхПродажахТовары/ДокументОтчетОРозничныхПродажахТовары_$(FileSuffix).qvd](qvd);
    DROP Tables ДокументОтчетОРозничныхПродажахТовары;

    end if
    
    if InRollBack or isnull(FileSize('$(vQVDPath)/Документы/ДокументВозвратТоваровОтПокупателяТовары/ДокументВозвратТоваровОтПокупателяТовары_$(FileSuffix).qvd')) then

    TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

    ДокументВозвратТоваровОтПокупателяТовары:
    LOAD
        Text(_Document197_IDRRef) as Ссылка,
        text(_Fld1213RRef)        as КодНоменклатура,
        _LineNo1212               as НомерСтроки,
        _Fld1222                  as СуммаНДС,
        Text(_Fld1166_RRRef)      as КодСклад
    FROM [$(vDBQvdPath)/_Document/_Document197_VT1211/_Document197_VT1211_$(FileSuffix).qvd](qvd);

    store ДокументВозвратТоваровОтПокупателяТовары into  [$(vQVDPath)/Документы/ДокументВозвратТоваровОтПокупателяТовары/ДокументВозвратТоваровОтПокупателяТовары_$(FileSuffix).qvd](qvd);
    DROP Tables ДокументВозвратТоваровОтПокупателяТовары;

    end if
    
    
    if InRollBack or isnull(FileSize('$(vQVDPath)/Документы/ДокументnwpРекламнаяАкцияТовары/ДокументnwpРекламнаяАкцияТовары_$(FileSuffix).qvd')) then

    TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

    ДокументnwpРекламнаяАкцияТовары:
    LOAD
        Text(_Document383_IDRRef) as Ссылка,
        text(_Fld7748RRef) as КодНоменклатура
    FROM [$(vDBQvdPath)/_Document/_Document383_VT7745/_Document383_VT7745_$(FileSuffix).qvd](qvd);

    store ДокументnwpРекламнаяАкцияТовары into  [$(vQVDPath)/Документы/ДокументnwpРекламнаяАкцияТовары/ДокументnwpРекламнаяАкцияТовары_$(FileSuffix).qvd](qvd);
    DROP Tables ДокументnwpРекламнаяАкцияТовары;

    end if
    
    
    if InRollBack or isnull(FileSize('$(vQVDPath)/Документы/ДокументnwpРекламнаяАкцияТовары/ДокументnwpРекламнаяАкцияТовары_$(FileSuffix).qvd')) then

    TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

    ДокументnwpРекламнаяАкцияТовары:
    LOAD
        Text(_Document383_IDRRef) as Ссылка,
        text(_Fld7748RRef) as КодНоменклатура
    FROM [$(vDBQvdPath)/_Document/_Document383_VT7745/_Document383_VT7745_$(FileSuffix).qvd](qvd);

    store ДокументnwpРекламнаяАкцияТовары into  [$(vQVDPath)/Документы/ДокументnwpРекламнаяАкцияТовары/ДокументnwpРекламнаяАкцияТовары_$(FileSuffix).qvd](qvd);
    DROP Tables ДокументnwpРекламнаяАкцияТовары;

    end if
    

let DateInc = timestamp(AddMonths(DateInc, 1));

LOOP while not InMonth(DateInc, DateLoadTo, 1);	

//$tab РегистрыCведений---------------------------------------------------------------------
/*
РегистрСведений.КурсыВалют (_InfoRg9130)
РегистрСведений.ЗначенияСвойствОбъектов (_InfoRg9002)
РегистрСведений.Штрихкоды (_InfoRg9929)
РегистрСведений.ЦеныАТТ (_InfoRg9871)
*/

КурсыВалют:
LOAD
	Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) as Дата,
    _Fld9131RRef as КодВалюты,
    _Fld9132/_Fld9133 as Курс,
    _Fld9133 as Кратность
FROM [$(vDBQvdPath)/_InfoRg/_InfoRg9130.qvd](qvd);

store КурсыВалют into  [$(vQVDPath)РегистрыСведений\КурсыВалют.qvd](qvd);
drop table КурсыВалют;

ЗначенияСвойствОбъектов:
Load	
	_Fld9003_RRRef as КодОбъект,
    _Fld9004RRef as КодСвойство,
    _Fld9005_L as Значение1,
    _Fld9005_N as Значение2,
    _Fld9005_S as Значение3
FROM [$(vDBQvdPath)/_InfoRg/_InfoRg9002.qvd](qvd);

store ЗначенияСвойствОбъектов into  [$(vQVDPath)РегистрыСведений\ЗначенияСвойствОбъектов.qvd](qvd);
drop table ЗначенияСвойствОбъектов;

Штрихкоды:
Load	
	_Fld9931_RRRef as КодШтрихкод,
	_Fld9930 as Штрихкод
FROM [$(vDBQvdPath)/_InfoRg/_InfoRg9929.qvd](qvd);

store Штрихкоды into  [$(vQVDPath)РегистрыСведений\Штрихкоды.qvd](qvd);
drop table Штрихкоды;

ЦеныАТТ:
Load	
	Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) as Дата,
    Text(_RecorderRRef) as Ссылка,
	_Fld9872RRef as КодСклад,	 
	_Fld9873RRef as КодНоменклатура,	
	_Fld9877 as Цена	
FROM [$(vDBQvdPath)/_InfoRg/_InfoRg9871.qvd](qvd);

store ЦеныАТТ into  [$(vQVDPath)РегистрыСведений\ЦеныАТТ.qvd](qvd);
drop table ЦеныАТТ;

//$tab РегистрыНакоплений-------------------------------------------------------------------

//Подготавливаем документы Оптовых складов

ВидСкладаExists:
LOAD
  0 as _EnumOrder
AutoGenerate(1);//0 - оптовый склад

ВидыСкладовExistsId:
LOAD
  _IDRRef as _Fld12766RRef,
  _EnumOrder
FROM 
  [lib://OLAP (fixmt_stefanovich)/_Enum/_Enum486.qvd](qvd)
Where 
  Exists(_EnumOrder);

Склады:
LOAD
  _IDRRef as _Fld5057RRef,
  _IDRRef as _Fld1166_RRRef,
  _Fld12766RRef
FROM 
  [lib://OLAP (fixmt_stefanovich)/_Reference/_Reference132.qvd](qvd)
Where 
  Exists(_Fld12766RRef);

Drop Tables ВидСкладаExists, ВидыСкладовExistsId;

ККМ_NotExists:
LOAD
  '00000000000000000000000000000000' as _Fld1209RRef
AutoGenerate(1);// Пустой ЧекККМ

ОптExists:
LOAD
  _IDRRef as _RecorderRRef,
  _Fld5057RRef
FROM 
  [lib://OLAP (fixmt_stefanovich)/_Document/_Document299.qvd](qvd)
Where 
  Exists(_Fld5057RRef);

Concatenate(ОптExists)
LOAD
  _IDRRef  as _RecorderRRef,
  _Fld1166_RRRef,
  _Fld1209RRef
FROM 
  [lib://OLAP (fixmt_stefanovich)/_Document/_Document197.qvd](qvd)
Where 
  Exists(_Fld1209RRef) and Exists(_Fld1166_RRRef);

Drop Tables Склады, ККМ_NotExists;



/*
РегистрНакопления.ПартииТоваровНаСкладах (_AccumRg11058)
РегистрНакопления.ТоварыВРознице (_AccumRg11432)
*/
let DateInc = DateStart;
let DateLoadTo = DateFinish; 

do
	let DateFrom = DateInc; 
	let DateTo = MonthEnd(DateInc);
	let DateToSQL = date(MonthEnd(DateInc)+1);
	let FileSuffix = Text(date(AddYears(DateInc,-2000),'YYYY_MM'));
	let InRollBack  = (DateInc>=AddMonths(DateLoadTo, -RollBackMonthCount));

	if InRollBack or isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ПартииТоваровНаСкладах/ПартииТоваровНаСкладах_$(FileSuffix).qvd')) then

	TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

    ПартииТоваровНаСкладах:
    LOAD
        Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) as	Дата,
//         2 As ТипДвижения,
        _Active as Активность,
        Text(_RecorderRRef) as Ссылка,
        Text(_RecorderTRef) as ТипДокумент,
        _RecordKind as ВидДвижения,
//         _LineNo as Строка,
        text(_Fld11059RRef) as КодНоменклатура,
        text(_Fld11060RRef) as КодСклад,
        text(_Fld11063_RRRef) as КодДокументОприходования,	
        _Fld11067 as Количество,
        _Fld11069 as Себестоимость 
        
        
    FROM [$(vDBQvdPath)/_AccumRg/_AccumRg11058/_AccumRg11058_$(FileSuffix).qvd](qvd);

	store ПартииТоваровНаСкладах into  [$(vQVDPath)/РегистрыНакоплений/ПартииТоваровНаСкладах/ПартииТоваровНаСкладах_$(FileSuffix).qvd](qvd);
	DROP Tables ПартииТоваровНаСкладах;
	
    end if

	if InRollBack or isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ТоварыВРознице/ТоварыВРознице_$(FileSuffix).qvd')) then

	TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

    ТоварыВРознице:
    LOAD
        Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) as	Дата,
        Text(_RecorderRRef) as Ссылка,
        Text(_RecorderTRef) as ТипДокумент,
        text(_Fld11434RRef) as КодНоменклатура,
        text(_Fld11433RRef) as КодСклад,
        _LineNo             as НомерСтроки,
        _Fld11438           as Количество,
        _Fld11442           as Стоимость,
        _Fld11439           as СуммаПродажная
//         Sum(_Fld11439)/Sum(_Fld11438) as ЦенаПродажная,
//         Sum(_Fld11442)/Sum(_Fld11438) as Цена 
    FROM [$(vDBQvdPath)/_AccumRg/_AccumRg11432/_AccumRg11432_$(FileSuffix).qvd](qvd);
    //Group by _RecorderRRef,_RecorderTRef,_Period,_Fld11434RRef,_Fld11433RRef;
    
    
        
	store ТоварыВРознице into  [$(vQVDPath)/РегистрыНакоплений/ТоварыВРознице/ТоварыВРознице_$(FileSuffix).qvd](qvd);
	DROP Tables ТоварыВРознице;
	
    end if
    
//     if InRollBack or isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ПартииТоваровНаСкладахИтоги/ПартииТоваровНаСкладахИтоги_$(FileSuffix).qvd')) then

// 	TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

//     ПартииТоваровНаСкладахИтоги:
//     LOAD
//         Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) as	Дата,
//         text(_Fld11059RRef) as КодНоменклатура,
//         text(_Fld11060RRef) as КодСклад,
//         text(_Fld11063_RRRef) as КодДокументОприходования,	
//         _Fld11067 as Количество,
//         _Fld11069 as Себестоимость         
        
//     FROM [$(vDBQvdPath)/_AccumRg/_AccumRgT11081/_AccumRgT11081_$(FileSuffix).qvd](qvd);

// 	store ПартииТоваровНаСкладахИтоги into  [$(vQVDPath)/РегистрыНакоплений/ПартииТоваровНаСкладахИтоги/ПартииТоваровНаСкладахИтоги_$(FileSuffix).qvd](qvd);
// 	DROP Tables ПартииТоваровНаСкладахИтоги;
    
// 	end if
	if InRollBack or isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ПродажиОпт/ПродажиОпт_$(FileSuffix).qvd')) then

        ПродажиTmp:
        LOAD
            _Period,
            _RecorderTRef,
            _RecorderRRef,
            _LineNo,
            _Fld11223RRef,
            _Fld11233,
            _Fld11234,
            _Fld11235
        FROM 
            [lib://OLAP (fixmt_stefanovich)/_AccumRg/_AccumRg11222/_AccumRg11222_$(FileSuffix).qvd](qvd)
        Where 
            Exists(_RecorderRRef);

        ПродажиОпт:
        LOAD
            Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) 	as Дата,
            Text(_RecorderRRef) 								as Ссылка,
            Text(_RecorderTRef) 								as ТипДокумент,
            Text(_Fld11223RRef) 								as КодНоменклатура,
            _LineNo 											as НомерСтроки,
            _Fld11233 											as Количество ,
            _Fld11234 											as Стоимость,
            _Fld11235 											as СтоимостьБезСкидок
        Resident 
            ПродажиTmp;

        Drop Table ПродажиTmp;

        store ПродажиОпт into  [$(vQVDPath)/РегистрыНакоплений/ПродажиОпт/ПродажиОпт_$(FileSuffix).qvd](qvd);
        DROP Tables ПродажиОпт;
	
    end if


let DateInc = timestamp(AddMonths(DateInc, 1));

LOOP while not InMonth(DateInc, DateLoadTo, 1);	

Drop Table ОптExists;

//$tab ПланВидовХарактеристик---------------------------------------------------------------
/*
ПланВидовХарактеристик.СвойстваОбъектов (_Chrc656)
*/

СвойстваОбъектов:
LOAD
	Text(_IDRRef) as Ссылка,
    _Code as КодСвойства
FROM [$(vDBQvdPath)/_Chrc/_Chrc656.qvd](qvd);

store СвойстваОбъектов into  [$(vQVDPath)ПланВидовХарактеристик\СвойстваОбъектов.qvd](qvd);
drop table СвойстваОбъектов;


//$tab Перечисления-------------------------------------------------------------------------

/*
Перечисление.nwpСтатусРА (_Enum624)
Перечисление.СтавкиНДС (_Enum565)
Перечисление.nwpСтатусТовара (_Enum625)
*/

nwpСтатусРА:
Load	
	Text(_IDRRef) as КодnwpСтатусРА,
    _EnumOrder as  Порядок
FROM [$(vDBQvdPath)/_Enum/_Enum624.qvd](qvd);
Left Join(nwpСтатусРА)
LOAD * Inline
[Порядок,nwpСтатусРА
0,На согласовании
1,Согласовано
2,Выгружено
3,Действует
4,Завершена
];

DROP Field Порядок From nwpСтатусРА;
store nwpСтатусРА into  [$(vQVDPath)Перечисление\nwpСтатусРА.qvd](qvd);
drop table nwpСтатусРА;

СтавкиНДС:
Load	
	Text(_IDRRef) as КодСтавкиНДС,
    _EnumOrder as  Порядок
FROM [$(vDBQvdPath)/_Enum/_Enum565.qvd](qvd);
Left Join(СтавкиНДС)
LOAD * Inline
[Порядок,СтавкаНДС
0,'18%'
1,'18% / 118%'
2,'10%'
3,'10% / 110%'
4,'0%'
5,'Без НДС'
6,'20%'
7,'20% / 120%'
8,'22%'
9,'22% / 122%'
10,'24%'
11,'24% / 124%'
12,'Расчетная'
13,'16,67%'
14,'9,09%'
];

DROP Field Порядок From СтавкиНДС;
store СтавкиНДС into  [$(vQVDPath)Перечисление\СтавкиНДС.qvd](qvd);
drop table СтавкиНДС;

nwpСтатусТовара:
Load	
	Text(_IDRRef) as КодnwpСтатусТовара,
    _EnumOrder as  Порядок
FROM [$(vDBQvdPath)/_Enum/_Enum625.qvd](qvd);
Left Join(nwpСтатусТовара)
LOAD * Inline
[Порядок,nwpСтатусТовара, АктивныйАссортимент
0,'Анализ',0
1,'Ассортимент',1
2,'ВИП',1
3,'Возврат',0
4,'Вывод',0
5,'Новинка',0
6,'Приостановка поставок',0
7,'Сток',0
8,'Сезон',1
9,'Корзина доп продаж',1
10,'Анонс',1
11,'(не использ.) Зима',0
12,'(не использ.) Лето',0
13,'АП',1
14,'KVI',1
15,'Рекламная игра',1
16, Распродажа,1
17, Неликвид,0
];

DROP Field Порядок From nwpСтатусТовара;
store nwpСтатусТовара into  [$(vQVDPath)Перечисление\nwpСтатусТовара.qvd](qvd);
drop table nwpСтатусТовара;

//exit script;

//$tab BUH-PLAYH----------------------------------------------------------------------------
СкладыBUH:
LOAD
	_Fld16146_RRRef as КодСклад,
    Num#(_Fld16144) as НомерМагазина
FROM [$(vDBQvdPath)/BUH-PLAYH/_Reference115.qvd](qvd)
where Num#(_Fld16144) > 0;

left Join

LOAD
	_Fld12835 as НомерМагазина,
    _Description as  Склад,
    _Fld12772 as Город,
    _Fld12795RRef as КодТипМагазин, // Категория магазина
	_Fld12851 as РейтингАВС,
    _Fld12863 as РаботаСПродуктами,
    _Fld12893 as Широта,
    _Fld12894 as Долгота
FROM [$(vDBQvdPath)/_Reference/_Reference132.qvd](qvd)
where _Fld12835 > 0;

left Join

Load
	КодТипМагазин,
	ТипМагазина
RESIDENT КатегорияМагазина;

store СкладыBUH into  [$(vQVDPath)Справочники\СкладыBUH.qvd](qvd);

drop table СкладыBUH, КатегорияМагазина;

//exit script;
ДокументПоказателиОтчетаПоТО:
LOAD
    _Document18982_IDRRef as Ссылка,
    Дата,
    _KeyField as Ключ,
    _LineNo18991 as НомерСтроки,
    _Fld18992RRef as ТорговыеОбъекты,
//     _Fld18993 as ВыручкаСНДС,
//     _Fld18994 as ВыручкаМелкийОпт,
    _Fld18995 as ВыручкаИтого,
    _Fld18996 as ВыручкаБезНДС,
    _Fld18997 as Себестоимость, 
    _Fld18998 as ДоляСебестоимостиВВыручкеБезНДС,
    _Fld18999 as ВаловаяПрибыль,
    _Fld19000 as ДоляВВыручкеБезНДС,
    _Fld19001 as ОплатаТрудаТО,
    _Fld19002 as ДоляФОТвВыручкеБезНДС,
    _Fld19003 as ОплатаТрудаУправление,
    _Fld19004 as ОтчисленияВФСЗНБелгосстрах,
    _Fld19005 as КоммунальныеУслуги,
    _Fld19006 as УслугиСвязи,
    _Fld19007 as ТехническоеОбслуживаниеКСА,
    _Fld19008 as ТехническоеОбслуживаниеТреминалов,
    _Fld19009 as ОбслуживаниеОборудования,
    _Fld19010 as Маркетинг,
    _Fld19011 as АмортизацияОС,
    _Fld19012 as СЭС,
    _Fld19013 as БанковскиеУслуги,
    _Fld19014 as АмортизацияМБП,
    _Fld19015 as АрендаПомещений,
    _Fld19016 as ДоляАрендыВВыручкеБезНДС,
    _Fld19017 as ПогрузоРазгрузочныеРаботы,
    _Fld19018 as ПочтовыеРасходы,
    _Fld19019 as УслугиПоУстановкеМонтажу,
    _Fld19020 as СырьеИМатериалы,
    _Fld19119 as НДСНаЗатраты,
    _Fld19021 as НалогНаНедвижимость,
    _Fld19022 as СодержаниеИРемонтЗдания,
    _Fld19023 as ПрочиеРасходы,
    _Fld19024 as СборОператоруВторичныхРесурсов,
    _Fld19025 as ТранспортныеРасходы,
    _Fld19657 as НедостачаИБрак,
    _Fld19026 as ДоляРеализационныхРасходовВВыручкеБезНДС,
    _Fld19027 as МаржинальнаяПрибыль1,
    _Fld19028 as РентабельностьПродаж1,
    _Fld19029 as Склад,
    _Fld19030 as МаржинальнаяПрибыль2,
    _Fld19031 as РентабельностьПродаж2,
    _Fld19032 as ОХР,
    _Fld19033 as БалансоваяПрибыль,
    _Fld19034 as РентабельностьПродаж
//     _Fld19120 as Изменен,
//     _Fld19121 as ИзмененныеДанные
FROM [$(vDBQvdPath)/BUH-PLAYH/_Document18982_VT18990.qvd]
(qvd);

store ДокументПоказателиОтчетаПоТО into  [$(vQVDPath)/Документы/ДокументПоказателиОтчетаПоТО.qvd](qvd);
    DROP Tables ДокументПоказателиОтчетаПоТО;
    
let DateLoadStart = MakeDate(2023,1,1);
let DateLoadEnd = MonthEnd(today(1));
let IncPeriod = DateLoadStart;


do 

	let PeriodStart = IncPeriod;
	let PeriodEnd = AddMonths(IncPeriod, 1);
	let FileSuffix = Text(date(IncPeriod,'YYYY_MM'));
    let InRollBack  = (IncPeriod>=AddMonths(DateLoadTo, -RollBackMonthCount));

    if InRollBack or isnull(FileSize('$(vQVDPath)/SET/BUH-PLAYH/Чеки/ЧекиФинМодельТО_$(FileSuffix).qvd')) then
	
	TRACE 'Calc period= $(FileSuffix)';

чеки:
LOAD
    Dayname(Дата)                                              as ДатаЧеки,
    Count(distinct If(operationtype=True(),id))                as колво_чек,
    shopindex                                                  as НомерМагазина,
    sum(If(operationtype=True(),checksumend,-checksumend))/100 as Сумма
FROM [$(vQVDPath)/SET/od_purchase/od_purchase_$(FileSuffix).qvd](qvd)
    where shopindex>0 and id>0
    Group by Dayname(Дата), shopindex;

store чеки into  [$(vQVDPath)/SET/BUH-PLAYH/Чеки/ЧекиФинМодельТО_$(FileSuffix).qvd](qvd);
    DROP Tables чеки;
    end if

let IncPeriod = AddMonths(IncPeriod, 1);
loop while not InMonth(IncPeriod, DateLoadEnd, 1);

//exit script;


