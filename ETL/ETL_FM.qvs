//РегистрСведений.Ассортимент ИтогиСрезПоследних
_InfoRgSL15020:
LOAD *;	
SQL 
SELECT 
	irs.[_Fld15013RRef] as КодСтрЕд, 
    irs.[_Fld15014RRef] as КодНоменклатура,
    irs.[_Fld15015RRef] as КодСтатусТовара,
    r488._Description as СтатусТовара
FROM "UT-WBFM".dbo."_InfoRgSL15020" as irs
join
"UT-WBFM".dbo."_Reference488X1" as r488 //Справочник.СтатусыНоменклатуры
on 
irs.[_Fld15015RRef]=r488._IDRRef;
//Group by [_Fld15013RRef], [_Fld15014RRef], [_Fld15015RRef];
store _InfoRgSL15020 into [$(vQVDPath)РегистрыСведений\СтатусыНоменклатурыФакт.qvd](qvd);
drop table _InfoRgSL15020;


//РегистрСведений.Ассортимент
Ассортимент:
LOAD
	КодСтрЕд,
	Count(distinct КодНоменклатура) as АссортSKU //К-во SKU в ассортименте структурной еденицы
FROM [$(vDBQvdPath)/_InfoRg/_InfoRg15012.qvd](qvd)
where [КодСтатусТовара]<>'831F00155D00024711EF3529D0B02BFE' // Все статусы товаров кроме "пассивный"
group by КодСтрЕд;

store Ассортимент into  [$(vQVDPath)РегистрыСведений\Ассортимент.qvd](qvd);
drop table Ассортимент;

