//РегистрСведений.СтатусЗаказовТоваров
_InfoRg18886:
LOAD * ;
SQL
SELECT
    ir._Fld18887RRef КодЗаказ,
    d.[_Number] N_заказ,
    ir._Fld18888_RRRef КодКонтрагент,
    Convert(date,DATEADD(YEAR, -2000, ir._Fld18891),23) as Дата,
    d._Fld2886RRef as КодСтрЕд,
    ir._Fld18892	ЕстьСтатусЧерновик,
    ir._Fld18893	ЕстьСтатусЗаказано	,
    ir._Fld18894	ЕстьСтатусНаКонсолидацию	,
    ir._Fld18895	ЕстьСтатусКонсолидирован	,
    ir._Fld18896	ЕстьСтатусПодтвержден	,
    ir._Fld18897	ЕстьСтатусПоставкаТовара	,
    ir._Fld18898	ЕстьСтатусЗакрытиеНедопоставки	,
    ir._Fld18899	ЕстьСтатусЗакрытиеНедопоставкиПриОтгрузкеСоСклада	,
    ir._Fld18900	ЕстьСтатусРучноеЗакрытие	,
    ir._Fld18901	СогласованиеВСтатусеЧерновик	,
    ir._Fld18902	СогласованиеВСтатусеЗаказано	,
    ir._Fld18903	СогласованиеВСтатусеНаКонсолидацию	,
    ir._Fld18904	СогласованиеВСтатусеКонсолидирован	,
    ir._Fld18905	СогласованиеВСтатусеПодтвержден	,
    ir._Fld18906	Закрыт,
    ir._Fld18907	СтрокаСтатусов,
    ir._Fld18908	СтрокаСтатусовСогласования,
    ir._Fld18909	Приемка,
    ir._Fld18910RRef	Субассортимент,
    ir._Fld18911	Алкоголь,
    ir._Fld18912	МаркированныйТовар,
    ir._Fld18913	Меркурий,
    ir._Fld18914	КвоSKUЗаказ,
    ir._Fld18915	СуммаЗаказ,
    ISNULL(ar.[Кво], 0) AS КвоШтЗаказ
FROM [UT-WBFM].dbo.[_InfoRg18886] AS ir
LEFT JOIN (
    SELECT
        [_RecorderRRef],
        SUM([_Fld19914]) AS [Кво]
    FROM [UT-WBFM].dbo.[_AccumRg19907]
    GROUP BY [_RecorderRRef]
) AS ar
    ON ir.[_Fld18887RRef] = ar.[_RecorderRRef]
LEFT JOIN [UT-WBFM].dbo.[_Document595X1] AS d ON ir.[_Fld18887RRef] = d.[_IDRRef]    
    ;
store _InfoRg18886 into [$(vQVDPath)/РегистрыСведений/СтатусЗаказовТоваров.qvd](qvd);
drop table _InfoRg18886;

//exit script;

//$tab РегистрыНакоплений-------------------------------------------------------------------

//Подготавливаем документы Оптовых складов
// РегистрНакопления.ДвижениеТМЦ (_AccumRg19831)
// РегистрНакопления.ПартииНоменклатуры (_AccumRg20148)
// РегистрНакопления.УчетПродаж (_AccumRg20403)
// РегистрНакопления.УчетОтклонений (_AccumRg20370)

// КодыОпераций:
// Load
//       КодОперации,
//       ОперацияДвиженияТМЦ
// FROM [$(vQVDPath)\Перечисление\КодыОпераций.qvd](qvd);



// ВидСкладаExists:
// LOAD
//   0 as _EnumOrder
// AutoGenerate(1);//0 - оптовый склад

// ВидыСкладовExistsId:
// LOAD
//   _IDRRef as _Fld12766RRef,
//   _EnumOrder
// FROM 
//   [lib://OLAP_FM/_Enum/_Enum884.qvd](qvd)
// Where 
//   Exists(_EnumOrder);

let DateInc = DateStart;
let DateLoadTo = DateFinish; 

do
	let DateFrom = DateInc; 
	let DateTo = MonthEnd(DateInc);
	let DateToSQL = date(MonthEnd(DateInc)+1);
	let FileSuffix = Text(date(AddYears(DateInc,-2000),'YYYY_MM'));
	let InRollBack  = (DateInc>=AddMonths(DateLoadTo, -RollBackMonthCount));

//РегистрНакопления.ПартииТоваровНаСкладах - РегистрНакопления.УчетПартий (_AccumRg20384)
	if InRollBack or isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ПартииТоваровНаСкладах/ПартииТоваровНаСкладах_$(FileSuffix).qvd')) then
	TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

    ПартииТоваровНаСкладах:
	Load
    	Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) as Дата,
        _Active as Активность,
        Text(_RecorderRRef) as Ссылка,
        Text(_RecorderTRef) as ТипДокумент,
        _RecordKind as ВидДвижения,
        _LineNo as НомерСтроки,
        //Text(_RecorderRRef)&_LineNo as KeyMovItem,
        text(_Fld20385RRef) 	as КодНоменклатура,
        text(_Fld20387_RRRef)	as КодСклад,
        text(_Fld20390RRef) 	as КодДокументОприходования,  //Партия
        _Fld20391 				as Количество,
    	_Fld20392 				as СебестоимостьБНДС,
        _Fld20393				as СуммаНДСсебес,
        _Fld20396RRef			as КодОперации
    
    FROM [$(vDBQvdPath)\_AccumRg\_AccumRg20384\_AccumRg20384_$(FileSuffix).qvd](qvd);
    
    left Join
    LOAD 
    	Ссылка,
        КодКонтрагент
    FROM [$(vQVDPath)Документы\ПоступлениеТоваровИУслуг.qvd](qvd);
     
	store ПартииТоваровНаСкладах into  [$(vQVDPath)/РегистрыНакоплений/ПартииТоваровНаСкладах/ПартииТоваровНаСкладах_$(FileSuffix).qvd](qvd);
	DROP Tables ПартииТоваровНаСкладах;
	end if
    
//РегистрНакопления.ПартииНоменклатуры (_AccumRg20148)    
//      LOAD
//         Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) as	Дата,
//         _Active as Активность,
//         Text(_RecorderRRef) as Ссылка,
//         Text(_RecorderTRef) as ТипДокумент,
//         _RecordKind as ВидДвижения,
//         _LineNo as НомерСтроки,
//         //Text(_RecorderRRef)&_LineNo as KeyMovItem,
//         text(_Fld20149RRef) 	as КодНоменклатура,
//         text(_Fld20151_RRRef)	as КодСклад,
//         text(_Fld20153RRef) 	as КодДокументОприходования,  //Партия,
//         _Fld20154 			as Количество,
//         _Fld20155 			as Себестоимость,
//         _Fld20157RRef 		as КодОперации,
//         _Fld20158 			as СуммаПродажная
        
//     FROM [$(vDBQvdPath)/_AccumRg/_AccumRg20148/_AccumRg20148_$(FileSuffix).qvd](qvd);
    
    

//РегистрНакопления.УчетПродаж (_AccumRg20403)
	if InRollBack or isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ТоварыВРознице/ТоварыВРознице_$(FileSuffix).qvd')) then

	TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

    ТоварыВРознице:
    LOAD
        Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) as Дата,
        Text(_RecorderRRef) as Ссылка,
        Text(_RecorderTRef) as ТипДокумент,
        text(_LineNo)       as НомерСтроки,
        //_RecorderRRef&_LineNo as KeyMovItem,        
        text(_Fld20406_RRRef) as КодНоменклатура,
        text(_Fld20407RRef) as КодСклад,
        text(_Fld20409RRef) as "КодСтавкиНДС",
 
 //////////////////////////////////////////////////////////////////////
 		Text(_Fld20411RRef) as КодКонтрагент, //Поставщик,
 ///////////////////////////////////////////////////////////////////////////////
        _Fld20418           as Количество,
        _Fld20415           as СуммаПродажная,
        _Fld20416			as СуммаНДС,
        _Fld20417           as Стоимость,
     	_Fld20419			as СуммаНДСВх
   
	FROM [$(vDBQvdPath)/_AccumRg/_AccumRg20403/_AccumRg20403_$(FileSuffix).qvd](qvd);
       
    //Group by _RecorderRRef,_RecorderTRef,_Period,_Fld11434RRef,_Fld11433RRef;
	store ТоварыВРознице into  [$(vQVDPath)/РегистрыНакоплений/ТоварыВРознице/ТоварыВРознице_$(FileSuffix).qvd](qvd);
    DROP Tables ТоварыВРознице;
	
    end if


//РегистрНакопления.ДвижениеТМЦ (_AccumRg19831)
	if InRollBack or isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/ДвижениеТМЦ/ДвижениеТМЦ_$(FileSuffix).qvd')) then

	TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

    ТоварыВРознице:
    LOAD
        Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) as Дата,
        Text(_RecorderRRef) as Ссылка,
        Text(_RecorderTRef) as ТипДокумент,
        text(_Fld19832RRef) as КодНоменклатура,
        text(_Fld19836RRef) as КодСклад,
        text(_LineNo)       as НомерСтроки,
        //_RecorderRRef&_LineNo as KeyMovItem,
       	_Fld19838RRef 		as КодОперации,
        _Fld19841           as Количество,
        _Fld19842           as СуммаПродажная,
        _Fld19843           as Прибыль,
     	_Fld19842-_Fld19843 as Стоимость
   
    
    FROM [$(vDBQvdPath)/_AccumRg/_AccumRg19831/_AccumRg19831_$(FileSuffix).qvd](qvd);
       
    //Group by _RecorderRRef,_RecorderTRef,_Period,_Fld11434RRef,_Fld11433RRef;
	store ТоварыВРознице into  [$(vQVDPath)/РегистрыНакоплений/ДвижениеТМЦ/ДвижениеТМЦ_$(FileSuffix).qvd](qvd);
    DROP Tables ТоварыВРознице;
	
    end if


//РегистрНакопления.УчетОтклонений (_AccumRg20370)
	if InRollBack or isnull(FileSize('$(vQVDPath)/РегистрыНакоплений/РаспределениеДопрасходов/РаспределениеДопрасходов_$(FileSuffix).qvd')) then

	TRACE 	$(DateFrom) -- 	$(DateTo)-- $(DateToSQL);		//write to log, for debug	

    РаспределениеДопрасходов:
    LOAD
        Date#(Date(AddYears(_Period,-2000),'DD.MM.YYYY')) as Дата,
        Text(_RecorderRRef) as Ссылка,
        Text(_RecorderTRef) as ТипДокумент,
        _Fld20376 as СуммаБезНДС,
        _Fld20377 as СуммаНДС,
        Text(_Fld20371RRef) as КодНоменклатуры,
        Text(_Fld20379RRef) as КодСклад
	FROM [$(vDBQvdPath)/_AccumRg/_AccumRg20370/_AccumRg20370_$(FileSuffix).qvd](qvd)
    Where "_RecorderTRef" =  '00000254';
       
    //Group by _RecorderRRef,_RecorderTRef,_Period,_Fld11434RRef,_Fld11433RRef;
	store РаспределениеДопрасходов into  [$(vQVDPath)/РегистрыНакоплений/РаспределениеДопрасходов/РаспределениеДопрасходов_$(FileSuffix).qvd](qvd);
    DROP Tables РаспределениеДопрасходов;
	
    end if



