//$tab Документы----------------------------------------------------------------------------

/*
Документ.ПоступлениеТоваровИУслуг - Документ.ПриходнаяНакладная (_Document688)
Документ.РеализацияТоваровУслуг - Документ.РасходнаяНакладная (_Document693)
Документ.ОтчетОРозничныхПродажах - Документ.Документ.Zотчет (_Document567)
Документ.ВозвратТоваровОтПокупателя - Документ.ВозвратнаяНакладная (_Document587)
Документ.nwpРекламнаяАкция - Документ.МаркетинговоеМероприятие (_Document631)
Документ.ПереоценкаТоваровВРознице (_Document674) - Документ.Переоценка (_Document674)

Документ.ОтчетОРозничныхПродажах (_Document270)
Документ.ПеремещениеТоваров (_Document272)
Документ.ВозвратТоваровПоставщику (_Document198)
Документ.ОприходованиеТоваров (_Document263)
Документ.СписаниеТоваров (_Document306)
*/

//Приходная накладная, перемещение на ТО
ПоступлениеТоваровИУслуг: 
LOAD
	'ПоступлениеТоваровИУслуг' as Документ,
    Date#(Date(AddYears(_Date_Time,-2000),'DD.MM.YYYY')) as Дата, /////////////////////////Новое поле
	Text(_IDRRef) as Ссылка,
    _Fld5920_RRRef as КодКонтрагент /////////////////////////////////////////КодКонтрагента
FROM [$(vDBQvdPath)/_Document/_Document688.qvd](qvd);

store ПоступлениеТоваровИУслуг into  [$(vQVDPath)Документы\ПоступлениеТоваровИУслуг.qvd](qvd);
drop table ПоступлениеТоваровИУслуг;

//Реализация или перемещение
РеализацияТоваровУслуг:
LOAD
	'РеализацияТоваровУслуг' as Документ,
	Text(_IDRRef)            as Ссылка,
    Text(_Fld6205RRef)       as КодСклад,
    _Fld6211RRef 			 as КодСтрЕд,
    _Fld6212_RRRef 			 as Грузополучатель    
FROM [$(vDBQvdPath)/_Document/_Document693.qvd](qvd);

store РеализацияТоваровУслуг into  [$(vQVDPath)Документы\РеализацияТоваровУслуг.qvd](qvd);
drop table РеализацияТоваровУслуг;


ОтчетОРозничныхПродажах:
LOAD
	'ОтчетОРозничныхПродажах' as Документ,
	Text(_IDRRef) as Ссылка
FROM [$(vDBQvdPath)/_Document/_Document567.qvd](qvd);

store ОтчетОРозничныхПродажах into  [$(vQVDPath)Документы\ОтчетОРозничныхПродажах.qvd](qvd);
drop table ОтчетОРозничныхПродажах;


ВозвратТоваровОтПокупателя:
LOAD
	'ВозвратТоваровОтПокупателя' as Документ,
	Text(_IDRRef)                as Ссылка,
    Text(_Fld2598RRef)         as КодСклад
FROM [$(vDBQvdPath)/_Document/_Document587.qvd](qvd);

store ВозвратТоваровОтПокупателя into  [$(vQVDPath)Документы\ВозвратТоваровОтПокупателя.qvd](qvd);
drop table ВозвратТоваровОтПокупателя;


nwpРекламнаяАкция:
LOAD
	Text(_IDRRef) as Ссылка,
    _Fld5261 as ОписаниеРА,
    Date#(Date(AddYears(_Fld5258,-2000),'DD.MM.YYYY')) as ДатаНачалаРА,
    Date#(Date(AddYears(_Fld5259,-2000),'DD.MM.YYYY')) as ДатаОкончанияРА
    //_Fld7738RRef as КодСтатусРА
FROM [$(vDBQvdPath)/_Document/_Document661.qvd](qvd)
where _Posted=01 and _Marked=00; // and _Fld7742<>'удалена';

store nwpРекламнаяАкция into  [$(vQVDPath)Документы\nwpРекламнаяАкция.qvd](qvd);
drop table nwpРекламнаяАкция;


//Документ.ПереоценкаТоваровВРознице
ПереоценкаТоваровВРознице:
LOAD
	'ПереоценкаТоваровВРознице' as Документ,
	Text(_IDRRef) as Ссылка,
